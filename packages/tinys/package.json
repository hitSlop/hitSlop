{
  "name": "@hitslop/tinys",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "tiny": "src/cli/cli.ts"
  },
  "dependencies": {
    "@crustjs/core": "0.5.4",
    "@crustjs/extensions": "0.5.4",
    "@crustjs/prompts": "0.2.6",
    "@crustjs/skills": "0.5.4",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "magic-string": "1.4.3",
    "periscopic": "4.0.3",
    "postcss": "8.5.6",
    "svelte": "5.57.2",
    "vite": "8.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/cli",
    "src/sdk",
    "src/schema",
    "src/wire",
    "templates",
    "skills",
    ".crust/root/skills",
    "shell",
    "browser",
    "engine",
    "tsconfig.tiny.json"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "description": "Create, preview, build, register, and edit tinys documents.",
  "license": "MIT",
  "homepage": "https://tinys.click",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hitSlop/tinys.git",
    "directory": "packages/tinys"
  },
  "bugs": {
    "url": "https://github.com/hitSlop/tinys/issues"
  },
  "exports": {
    ".": "./src/sdk/schema.ts",
    "./commands": "./src/sdk/commands.ts",
    "./svelte": "./src/sdk/app/store.svelte.ts",
    "./base.css": "./src/sdk/base.css",
    "./embed": "./src/sdk/app/embed.ts",
    "./youtube": "./src/sdk/app/youtube.ts",
    "./tsconfig.json": "./tsconfig.tiny.json",
    "./package.json": "./package.json"
  }
}
