{
  "manifest": {
    "type": "object",
    "required": [
      "author",
      "slug",
      "title",
      "description",
      "categories",
      "presentation"
    ],
    "properties": {
      "author": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S"
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri",
            "pattern": "^https?://[^/?#\\s]+"
          }
        },
        "title": "SlopAuthor",
        "additionalProperties": false
      },
      "slug": {
        "type": "string",
        "minLength": 2,
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "description": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "categories": {
        "type": "array",
        "items": {
          "enum": [
            "productivity",
            "utilities",
            "finance",
            "media",
            "games",
            "developer-tools",
            "education",
            "business",
            "personal",
            "health",
            "creative",
            "music",
            "other"
          ],
          "title": "SlopCategory"
        },
        "minItems": 1,
        "maxItems": 2,
        "uniqueItems": true
      },
      "presentation": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "width",
              "height"
            ],
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 240,
                "maximum": 4096
              },
              "height": {
                "type": "integer",
                "minimum": 180,
                "maximum": 4096
              },
              "resizable": {
                "type": "boolean"
              },
              "shape": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  {
                    "type": "object",
                    "required": [
                      "path"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "viewBox": {
                        "type": "array",
                        "additionalItems": false,
                        "items": [
                          {
                            "type": "number",
                            "minimum": 1,
                            "maximum": 16384
                          },
                          {
                            "type": "number",
                            "minimum": 1,
                            "maximum": 16384
                          }
                        ],
                        "minItems": 2
                      },
                      "fillRule": {
                        "enum": [
                          "nonzero",
                          "evenodd"
                        ]
                      }
                    },
                    "title": "SlopPathShape",
                    "additionalProperties": false
                  }
                ],
                "title": "SlopShape"
              },
              "lockAspect": {
                "type": "boolean"
              },
              "background": {
                "enum": [
                  "transparent",
                  "glass"
                ]
              }
            },
            "title": "SlopStandardPresentation",
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "width",
              "height",
              "skin"
            ],
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 240,
                "maximum": 4096
              },
              "height": {
                "type": "integer",
                "minimum": 180,
                "maximum": 4096
              },
              "skin": {
                "type": "string",
                "minLength": 12,
                "maxLength": 240,
                "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$)|.*//)assets/[A-Za-z0-9._/-]+\\.[pP][nN][gG]$"
              }
            },
            "title": "SlopSkinPresentation",
            "additionalProperties": false
          }
        ],
        "title": "SlopPresentation"
      }
    },
    "title": "SlopManifest",
    "additionalProperties": false
  },
  "commands": {
    "type": "object",
    "patternProperties": {
      "^[a-z][a-zA-Z0-9]{0,79}$": {
        "type": "object",
        "required": [
          "description",
          "args"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "args": {
            "type": "object",
            "properties": {},
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false,
    "maxProperties": 64
  },
  "limits": {
    "AppLimits": {
      "manifest": 65536,
      "text": 4194304,
      "assetPath": 240
    },
    "AssetLimits": {
      "file": 26214400,
      "count": 256,
      "bytes": 52428800,
      "imageSide": 16384,
      "imagePixels": 24000000
    },
    "DefaultWindowRadius": "22px",
    "ShapeLimits": {
      "path": 4096,
      "radius": 256,
      "viewBox": 16384
    },
    "ThemeLimit": 65536,
    "ThemeFileLimit": 66560,
    "ThemeTokenRule": {
      "nameLength": 64,
      "reservedPrefix": "window-",
      "tokens": 256
    }
  }
}
