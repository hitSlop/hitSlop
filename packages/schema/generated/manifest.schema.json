{
  "type": "object",
  "required": [
    "author",
    "slug",
    "title",
    "description",
    "categories",
    "presentation"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://api.hitslop.com/schemas/v1/manifest.schema.json"
    },
    "author": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "format": "uri",
          "pattern": "^https?://[^/?#\\s]+"
        }
      },
      "additionalProperties": false,
      "title": "SlopAuthor"
    },
    "slug": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "categories": {
      "type": "array",
      "items": {
        "enum": [
          "productivity",
          "utilities",
          "finance",
          "media",
          "games",
          "developer-tools",
          "education",
          "business",
          "personal",
          "other"
        ],
        "title": "SlopCategory"
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true
    },
    "presentation": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 240,
              "maximum": 4096
            },
            "height": {
              "type": "integer",
              "minimum": 180,
              "maximum": 4096
            },
            "resizable": {
              "type": "boolean"
            },
            "shape": {
              "enum": [
                "rounded",
                "ellipse",
                "capsule"
              ]
            },
            "background": {
              "type": "string",
              "const": "transparent"
            }
          },
          "additionalProperties": false,
          "title": "SlopStandardPresentation"
        },
        {
          "type": "object",
          "required": [
            "width",
            "height",
            "skin"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 240,
              "maximum": 4096
            },
            "height": {
              "type": "integer",
              "minimum": 180,
              "maximum": 4096
            },
            "skin": {
              "type": "string",
              "minLength": 12,
              "maxLength": 240,
              "pattern": "^assets/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+\\.[pP][nN][gG]$"
            }
          },
          "additionalProperties": false,
          "title": "SlopSkinPresentation"
        }
      ],
      "title": "SlopPresentation"
    }
  },
  "additionalProperties": false,
  "title": "SlopManifest"
}
