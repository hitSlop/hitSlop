{
  "type": "object",
  "required": [
    "author",
    "slug",
    "title",
    "description",
    "categories",
    "presentation",
    "packageFormat",
    "runtimeABI"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://api.hitslop.com/schemas/manifest.schema.json"
    },
    "author": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "format": "uri",
          "pattern": "^https?://[^/?#\\s]+"
        }
      },
      "title": "SlopAuthor",
      "additionalProperties": false
    },
    "slug": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "categories": {
      "type": "array",
      "items": {
        "enum": [
          "productivity",
          "utilities",
          "finance",
          "media",
          "games",
          "developer-tools",
          "education",
          "business",
          "personal",
          "other"
        ],
        "title": "SlopCategory"
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true
    },
    "presentation": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 240,
              "maximum": 4096
            },
            "height": {
              "type": "integer",
              "minimum": 180,
              "maximum": 4096
            },
            "resizable": {
              "type": "boolean"
            },
            "shape": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[ \t\r\n]*(?:0|(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:px|%))(?:[ \t\r\n]+(?:0|(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:px|%))){0,3}(?:[ \t\r\n]*/[ \t\r\n]*(?:0|(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:px|%))(?:[ \t\r\n]+(?:0|(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:px|%))){0,3})?[ \t\r\n]*$"
                },
                {
                  "type": "object",
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "viewBox": {
                      "type": "array",
                      "additionalItems": false,
                      "items": [
                        {
                          "type": "number",
                          "minimum": 1,
                          "maximum": 16384
                        },
                        {
                          "type": "number",
                          "minimum": 1,
                          "maximum": 16384
                        }
                      ],
                      "minItems": 2
                    },
                    "fillRule": {
                      "enum": [
                        "nonzero",
                        "evenodd"
                      ]
                    }
                  },
                  "title": "SlopPathShape",
                  "additionalProperties": false
                }
              ],
              "title": "SlopShape"
            },
            "lockAspect": {
              "type": "boolean"
            },
            "background": {
              "type": "string",
              "const": "transparent"
            }
          },
          "title": "SlopStandardPresentation",
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "width",
            "height",
            "skin"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 240,
              "maximum": 4096
            },
            "height": {
              "type": "integer",
              "minimum": 180,
              "maximum": 4096
            },
            "skin": {
              "type": "string",
              "minLength": 12,
              "maxLength": 240,
              "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$)|.*//)assets/[A-Za-z0-9._/-]+\\.[pP][nN][gG]$"
            }
          },
          "title": "SlopSkinPresentation",
          "additionalProperties": false
        }
      ],
      "title": "SlopPresentation"
    },
    "packageFormat": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "runtimeABI": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    }
  },
  "title": "SlopPackageManifest",
  "additionalProperties": false
}
