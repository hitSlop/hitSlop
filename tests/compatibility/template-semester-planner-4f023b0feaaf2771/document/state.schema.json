{
  "format": 1,
  "root": {
    "kind": "object",
    "properties": {
      "termTitle": {
        "kind": "text"
      },
      "academicYear": {
        "kind": "text"
      },
      "startMonth": {
        "kind": "string"
      },
      "courses": {
        "kind": "list",
        "item": {
          "kind": "object",
          "properties": {
            "code": {
              "kind": "string"
            },
            "name": {
              "kind": "text"
            },
            "colorHex": {
              "kind": "string"
            }
          }
        }
      },
      "milestones": {
        "kind": "list",
        "item": {
          "kind": "object",
          "properties": {
            "date": {
              "kind": "string"
            },
            "title": {
              "kind": "text"
            },
            "courseCode": {
              "kind": "string"
            },
            "type": {
              "kind": "enum",
              "values": [
                "Exam",
                "Paper",
                "Project",
                "Presentation",
                "Break",
                "Deadline"
              ]
            },
            "notes": {
              "kind": "text"
            }
          }
        }
      }
    }
  }
}