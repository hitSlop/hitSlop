{
  "kind": "object",
  "properties": {
    "title": {
      "kind": "text"
    },
    "version": {
      "kind": "string"
    },
    "epoch": {
      "kind": "integer"
    },
    "done": {
      "kind": "boolean"
    },
    "hits": {
      "kind": "counter"
    },
    "rows": {
      "kind": "list",
      "item": {
        "kind": "object",
        "properties": {
          "text": {
            "kind": "text"
          },
          "done": {
            "kind": "boolean"
          },
          "tags": {
            "kind": "list",
            "item": {
              "kind": "string"
            }
          },
          "notes": {
            "kind": "record",
            "value": {
              "kind": "string"
            }
          }
        }
      }
    },
    "label": {
      "kind": "string",
      "maxLength": 40
    },
    "ratio": {
      "kind": "number",
      "min": 0,
      "max": 1
    },
    "count": {
      "kind": "integer",
      "min": 0,
      "max": 100
    },
    "lane": {
      "kind": "enum",
      "values": [
        "todo",
        "doing",
        "done"
      ]
    },
    "note": {
      "kind": "optional",
      "inner": {
        "kind": "string"
      }
    },
    "memo": {
      "kind": "optional",
      "inner": {
        "kind": "text"
      }
    },
    "place": {
      "kind": "optional",
      "inner": {
        "kind": "object",
        "properties": {
          "name": {
            "kind": "string"
          },
          "visits": {
            "kind": "integer",
            "min": 0
          }
        }
      }
    },
    "settings": {
      "kind": "object",
      "properties": {
        "volume": {
          "kind": "integer",
          "min": 0,
          "max": 10
        },
        "muted": {
          "kind": "boolean"
        }
      }
    },
    "colors": {
      "kind": "list",
      "item": {
        "kind": "string"
      }
    },
    "checkins": {
      "kind": "record",
      "value": {
        "kind": "integer",
        "min": 0
      }
    },
    "cells": {
      "kind": "record",
      "value": {
        "kind": "object",
        "properties": {
          "input": {
            "kind": "text"
          },
          "width": {
            "kind": "optional",
            "inner": {
              "kind": "integer",
              "min": 0
            }
          }
        }
      }
    },
    "attachment": {
      "kind": "optional",
      "inner": {
        "kind": "string"
      }
    }
  }
}