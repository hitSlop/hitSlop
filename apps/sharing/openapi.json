        "summary": "Replace the SQLite seed while Uploading (owner only)",
        "parameters": [
          {
            "name": "room",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          },
          {
            "name": "X-Sharing-SHA256",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Sharing-App",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Sharing-Version",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
