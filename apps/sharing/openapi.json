  "components": {
    "schemas": {
      "ApiFailure": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Manifest": {
        "type": "object",
        "required": [
          "app",
          "resources"
        ],
        "properties": {
          "app": {
            "type": "string"
          },
          "resources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Resource"
            }
          }
        },
        "additionalProperties": false
      },
      "Resource": {
        "type": "object",
        "required": [
          "key",
          "hash",
          "size",
          "media_type"
        ],
        "properties": {
          "hash": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "ResourceGrant": {
        "type": "object",
        "required": [
          "app"
        ],
        "properties": {
          "app": {
            "type": "string"
          }
        }
      },
      "RoomInit": {
        "type": "object",
        "required": [
          "app",
          "seed",
          "seed_hash"
        ],
        "properties": {
          "app": {
            "type": "string"
          },
          "seed": {
            "type": "array",
            "items": {
              "type": "array",
              "items": false,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 0
                }
              ]
            }
          },
          "seed_hash": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "Refused": {
        "description": "Request refused; the local document is retained",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiFailure"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "capability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Room edit capability; creator-only routes instead require the creator capability. POST init also requires X-Preview-Create-Key, X-Admin-Key and X-Write-Key."
      }
    }
  }
}