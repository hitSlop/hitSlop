  "components": {
    "schemas": {
      "AccountRoomInit": {
        "type": "object",
        "required": [
          "identity",
          "init"
        ],
        "properties": {
          "identity": {
            "$ref": "#/components/schemas/RoomIdentity"
          },
          "init": {
            "$ref": "#/components/schemas/RoomInit"
          }
        }
      },
      "ApiFailure": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Invitation": {
        "type": "object",
        "description": "Sensitive host-owned data. Never forwarded to an authored page or printed in errors.",
        "required": [
          "document",
          "room",
          "origin",
          "capability",
          "seed_hash",
          "size"
        ],
        "properties": {
          "capability": {
            "type": "string"
          },
          "document": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "room": {
            "type": "string"
          },
          "seed_hash": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "Manifest": {
        "type": "object",
        "required": [
          "app",
          "resources"
        ],
        "properties": {
          "app": {
            "type": "string"
          },
          "resources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Resource"
            }
          }
        },
        "additionalProperties": false
      },
      "ReserveRoom": {
        "type": "object",
        "required": [
          "document",
          "generation"
        ],
        "properties": {
          "document": {
            "type": "string"
          },
          "generation": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "Resource": {
        "type": "object",
        "required": [
          "key",
          "hash",
          "size",
          "media_type"
        ],
        "properties": {
          "hash": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "ResourceGrant": {
        "type": "object",
        "required": [
          "app"
        ],
        "properties": {
          "app": {
            "type": "string"
          }
        }
      },
      "RoomIdentity": {
        "type": "object",
        "required": [
          "document",
          "generation",
          "room"
        ],
        "properties": {
          "document": {
            "type": "string"
          },
          "generation": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "room": {
            "type": "string"
          }
        }
      },
      "RoomInit": {
        "type": "object",
        "required": [
          "app",
          "seed",
          "seed_hash"
        ],
        "properties": {
          "app": {
            "type": "string"
          },
          "seed": {
            "type": "array",
            "items": {
              "type": "array",
              "items": false,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 0
                }
              ]
            }
          },
          "seed_hash": {
            "type": "string"
          }
        }
      },
      "RoomPhase": {
        "type": "string",
        "enum": [
          "pending",
          "published",
          "stopping",
          "ended"
        ]
      },
      "RoomReservation": {
        "type": "object",
        "description": "Private account response. Contains a recoverable bearer secret; never log it.",
        "required": [
          "document",
          "generation",
          "room",
          "phase"
        ],
        "properties": {
          "capability": {
            "type": [
              "string",
              "null"
            ]
          },
          "document": {
            "type": "string"
          },
          "generation": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "invitation": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Invitation"
              },
              {
                "type": "null"
              }
            ]
          },
          "phase": {
            "$ref": "#/components/schemas/RoomPhase"
          },
          "previous_room": {
            "type": [
              "string",
              "null"
            ]
          },
          "room": {
            "type": "string"
          }
        }
      },
      "VerifiedAccount": {
        "type": "object",
        "description": "Auth spike response. Never returns a bearer token or any sharing capability.",
        "required": [
          "uid",
          "auth_time"
        ],
        "properties": {
          "auth_time": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "uid": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "Refused": {
