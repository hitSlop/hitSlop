  "components": {
    "schemas": {
      "AccountRoom": {
        "type": "object",
        "required": [
          "room"
        ],
        "properties": {
          "room": {
            "type": "string"
          }
        }
      },
      "ApiFailure": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "CreateRoom": {
        "type": "object",
        "required": [
          "document"
        ],
        "properties": {
          "document": {
            "type": "string"
          }
        }
      },
      "CreatedRoom": {
        "type": "object",
        "required": [
          "room",
          "capability",
          "phase"
        ],
        "properties": {
          "capability": {
            "type": "string"
          },
          "phase": {
            "$ref": "#/components/schemas/RoomPhase"
          },
          "room": {
            "type": "string"
          }
        }
      },
      "Manifest": {
        "type": "object",
        "required": [
          "app",
          "resources"
        ],
        "properties": {
          "app": {
            "type": "string"
          },
          "resources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Resource"
            }
          }
        }
      },
      "Resource": {
        "type": "object",
        "required": [
          "key",
          "hash",
          "size",
          "media_type"
        ],
        "properties": {
          "hash": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "ResourceGrant": {
        "type": "object",
        "required": [
          "app"
        ],
        "properties": {
          "app": {
            "type": "string"
          }
        }
      },
      "RoomInfo": {
        "type": "object",
        "required": [
          "document",
          "phase"
        ],
        "properties": {
          "app": {
            "type": [
              "string",
              "null"
            ]
          },
          "capability": {
            "type": [
              "string",
              "null"
            ]
          },
          "document": {
            "type": "string"
          },
          "phase": {
            "$ref": "#/components/schemas/RoomPhase"
          },
          "seedHash": {
            "type": [
              "string",
              "null"
            ]
          },
          "seedSize": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "RoomPhase": {
        "type": "string",
        "enum": [
          "uploading",
          "live",
          "ended"
        ]
      }
    },
    "responses": {
      "Refused": {
        "description": "Request refused; the local document is retained",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiFailure"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "capability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Room edit capability for guest data access. Creator administration requires a verified Firebase identity."
      },
      "firebaseIdentity": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Firebase ID token, not a room capability"
      }
    }
  }
}