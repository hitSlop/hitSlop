        "properties": {
          "hash": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "ResourceGrant": {
        "type": "object",
        "required": [
          "app"
        ],
        "properties": {
          "app": {
            "type": "string"
          }
        }
      },
      "RoomInfo": {
        "type": "object",
        "required": [
          "document",
          "phase"
        ],
        "properties": {
          "app": {
            "type": [
              "string",
              "null"
            ]
          },
          "capability": {
            "type": [
              "string",
              "null"
            ]
          },
          "compact": {
            "type": "boolean"
          },
          "document": {
            "type": "string"
          },
          "phase": {
            "$ref": "#/components/schemas/RoomPhase"
          },
          "seedHash": {
            "type": [
              "string",
              "null"
            ]
          },
          "seedSize": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "RoomPhase": {
        "type": "string",
        "enum": [
          "uploading",
          "live",
          "ended"
        ]
      },
      "StagedSeed": {
        "type": "object",
        "required": [
          "seedHash",
          "size",
          "expiresAt"
        ],
        "properties": {
          "expiresAt": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "seedHash": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      }
    },
    "responses": {
      "Refused": {
        "description": "Request refused; the local document is retained",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiFailure"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "capability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Room edit capability for guest data access. Creator administration requires a verified Firebase identity."
      },
      "firebaseIdentity": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Firebase ID token, not a room capability"
      }
    }
  }
}