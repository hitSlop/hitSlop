  "components": {
    "schemas": {
      "AccessState": {
        "type": "object",
        "required": [
          "document",
          "sharing",
          "generation",
          "role"
        ],
        "properties": {
          "capability": {
            "type": [
              "string",
              "null"
            ]
          },
          "document": {
            "type": "string"
          },
          "generation": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "role": {
            "$ref": "#/components/schemas/DocumentRole"
          },
          "sharing": {
            "type": "boolean"
          }
        }
      },
      "ApiFailure": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "CreateRoom": {
        "type": "object",
        "required": [
          "document"
        ],
        "properties": {
          "document": {
            "type": "string"
          }
        }
      },
      "CreatedRoom": {
        "type": "object",
        "required": [
          "room",
          "capability",
