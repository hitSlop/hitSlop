  "paths": {
    "/_resources/{room}": {
      "post": {
        "summary": "Grant a short lived host-bound resource cookie on a UUID.dotslop.com origin",
        "parameters": [
          {
            "name": "room",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResourceGrant"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Accepted"
          },
          "403": {
            "$ref": "#/components/responses/Refused"
          },
          "409": {
            "$ref": "#/components/responses/Refused"
          },
          "410": {
            "$ref": "#/components/responses/Refused"
          },
          "413": {
            "$ref": "#/components/responses/Refused"
          },
          "429": {
            "$ref": "#/components/responses/Refused"
          }
        },
        "security": [
          {
            "capability": []
          }
        ]
      }
    },
