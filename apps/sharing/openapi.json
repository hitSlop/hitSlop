        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "BeginHandoff": {
        "type": "object",
        "required": [
          "token",
          "expected"
        ],
        "properties": {
          "expected": {
            "$ref": "#/components/schemas/EpochBase"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "CreateRoom": {
        "type": "object",
        "required": [
          "document"
        ],
        "properties": {
          "document": {
            "type": "string"
          }
        }
      },
      "CreatedRoom": {
        "type": "object",
        "required": [
          "room",
          "capability",
          "phase"
        ],
        "properties": {
          "capability": {
            "type": "string"
          },
          "phase": {
            "$ref": "#/components/schemas/RoomPhase"
          },
          "room": {
            "type": "string"
          }
        }
      },
      "EpochBase": {
        "type": "object",
        "required": [
          "seedHash",
          "heads"
        ],
        "properties": {
          "heads": {
            "type": "array",
            "items": {
              "type": "array",
              "items": false,
              "prefixItems": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                },
                {
                  "type": "integer",
                  "maximum": 2147483647,
                  "minimum": 0
                }
              ],
              "maxItems": 2,
              "minItems": 2
            },
            "description": "Unique peer pairs in ascending canonical peer order"
          },
          "seedHash": {
            "type": "string"
          }
        }
      },
      "EpochState": {
        "type": "object",
        "required": [
          "seedHash",
          "root",
          "heads"
        ],
        "properties": {
          "handoff": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Handoff"
              },
              {
                "type": "null"
              }
            ]
          },
          "heads": {
            "type": "array",
            "items": {
              "type": "array",
              "items": false,
              "prefixItems": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                },
                {
                  "type": "integer",
                  "maximum": 2147483647,
                  "minimum": 0
                }
              ],
              "maxItems": 2,
              "minItems": 2
            },
            "description": "Unique peer pairs in ascending canonical peer order"
          },
          "root": {
            "type": "array",
            "items": {
              "type": "array",
              "items": false,
              "prefixItems": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                },
                {
                  "type": "integer",
                  "maximum": 2147483647,
                  "minimum": 0
                }
              ],
              "maxItems": 2,
              "minItems": 2
            },
            "description": "Unique peer pairs in ascending canonical peer order"
          },
          "seedHash": {
            "type": "string"
          }
        }
      },
      "FinalizeHandoff": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "Handoff": {
        "type": "object",
        "required": [
          "token",
          "seedHash",
          "root",
          "heads"
        ],
        "properties": {
          "heads": {
            "type": "array",
            "items": {
              "type": "array",
              "items": false,
              "prefixItems": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                },
                {
                  "type": "integer",
                  "maximum": 2147483647,
                  "minimum": 0
                }
              ],
              "maxItems": 2,
              "minItems": 2
            },
            "description": "Unique peer pairs in ascending canonical peer order"
          },
          "root": {
            "type": "array",
            "items": {
              "type": "array",
              "items": false,
              "prefixItems": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                },
                {
                  "type": "integer",
                  "maximum": 2147483647,
                  "minimum": 0
                }
              ],
              "maxItems": 2,
              "minItems": 2
            },
            "description": "Unique peer pairs in ascending canonical peer order"
          },
          "seedHash": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "Manifest": {
        "type": "object",
        "required": [
          "app",
          "resources"
        ],
        "properties": {
          "app": {
            "type": "string"
          },
          "resources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Resource"
            }
          }
        }
      },
      "PublishEpoch": {
        "type": "object",
        "required": [
          "expected",
          "seedHash",
          "root",
          "resources",
          "attachments"
        ],
        "properties": {
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Resource"
            }
          },
          "expected": {
            "$ref": "#/components/schemas/EpochBase"
          },
          "resources": {
            "$ref": "#/components/schemas/Manifest"
          },
          "root": {
            "type": "array",
            "items": {
              "type": "array",
              "items": false,
              "prefixItems": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                },
                {
                  "type": "integer",
                  "maximum": 2147483647,
                  "minimum": 0
                }
              ],
              "maxItems": 2,
              "minItems": 2
            },
            "description": "Unique peer pairs in ascending canonical peer order"
          },
          "seedHash": {
            "type": "string"
          }
        }
      },
