/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/join
  Cache-Control: no-store
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# The callback keeps the Apple fragment in the browser; the hash pins its one inline script.
/auth/apple
  Cache-Control: no-store
  Content-Security-Policy: default-src 'none'; script-src 'sha256-7iMYMZ++YoqOkN8LuYYkJ1EsEECnXrG56v1sXL9UAEE='; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

/share-icon.png
  Cache-Control: public, max-age=3600
