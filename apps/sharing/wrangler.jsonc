{
  "name": "dotpop",
  "main": "../../generated/sharing/relay/worker/shim.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "routes": [{ "pattern": "share.dotpop.click", "custom_domain": true }],
  "assets": { "directory": "./public" },
  "vars": { "FIREBASE_PROJECT": "hitslopapp", "CREATION_ENABLED": "1" },
  "durable_objects": { "bindings": [{ "name": "DOCUMENTS", "class_name": "CloudDocument" }, { "name": "ACCOUNTS", "class_name": "DocumentAccount" }] },
  "migrations": [{ "tag": "documents-v1", "new_sqlite_classes": ["CloudDocument", "DocumentAccount"] }],
  "r2_buckets": [{ "binding": "SEEDS", "bucket_name": "dotpop-documents" }],
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "dotpop_documents" }],
  "ratelimits": [
    { "name": "COMPACT_LIMIT", "namespace_id": "27924748", "simple": { "limit": 6, "period": 60 } },
    { "name": "ACCOUNT_CREATE_LIMIT", "namespace_id": "27924743", "simple": { "limit": 5, "period": 60 } },
    { "name": "METADATA_LIMIT", "namespace_id": "27924744", "simple": { "limit": 120, "period": 60 } },
    { "name": "SEED_LIMIT", "namespace_id": "27924745", "simple": { "limit": 30, "period": 60 } },
    { "name": "CONNECT_LIMIT", "namespace_id": "27924746", "simple": { "limit": 60, "period": 60 } },
    { "name": "BLOB_LIMIT", "namespace_id": "27924747", "simple": { "limit": 120, "period": 60 } }
  ],
  "env": {
    "staging": {
      "name": "dotpop-staging",
      "assets": { "directory": "./public" },
      "vars": {
        "FIREBASE_PROJECT": "hitslopapp",
        "CREATION_ENABLED": "1"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "DOCUMENTS",
            "class_name": "CloudDocument"
          },
          {
            "name": "ACCOUNTS",
            "class_name": "DocumentAccount"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "SEEDS",
          "bucket_name": "dotpop-documents-staging"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "METRICS",
          "dataset": "dotpop_documents_staging"
        }
      ],
      "ratelimits": [
        {
          "name": "COMPACT_LIMIT",
          "namespace_id": "279247480",
          "simple": {
            "limit": 6,
            "period": 60
          }
        },
        {
          "name": "ACCOUNT_CREATE_LIMIT",
          "namespace_id": "279247430",
          "simple": {
            "limit": 5,
            "period": 60
          }
        },
        {
          "name": "METADATA_LIMIT",
          "namespace_id": "279247440",
          "simple": {
            "limit": 120,
            "period": 60
          }
        },
        {
          "name": "SEED_LIMIT",
          "namespace_id": "279247450",
          "simple": {
            "limit": 30,
            "period": 60
          }
        },
        {
          "name": "CONNECT_LIMIT",
          "namespace_id": "279247460",
          "simple": {
            "limit": 60,
            "period": 60
          }
        },
        {
          "name": "BLOB_LIMIT",
          "namespace_id": "279247470",
          "simple": {
            "limit": 120,
            "period": 60
          }
        }
      ]
    }
  }
}
