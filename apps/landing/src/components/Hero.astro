---
import AppleIcon from "./AppleIcon.astro";
import Desktop from "./playground/Desktop.svelte";
import { SITE_LINKS } from "../constants";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-top">
    <div class="hero-copy">
      <p class="kicker">Local-first mini apps for macOS</p>
      <h1 class="hero-title" id="hero-title">
        <span class="line">Tiny apps.<svg class="smiley wiggle" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="20" /><path d="M16 29c5 6 12 6 17-1" /><path class="dot" d="M17 18v2M31 18v2" /></svg></span>
        <span class="line"><span class="big">Big</span> <span class="underlined">personality.<svg class="underline draw" viewBox="0 0 300 18" preserveAspectRatio="none" aria-hidden="true" style="--len: 330"><path d="M4 12C70 4 170 3 296 9" /></svg></span></span>
      </h1>
      <p class="hero-sub">A packing list for one trip. A timer shaped like a tomato. A weird little desktop experiment you’ve been meaning to try. Each one is <strong>a single file you keep</strong>, and your AI can edit it too.</p>
      <div class="hero-actions">
        <a class="button button-primary" href={SITE_LINKS.download}><AppleIcon /> Download for Mac</a>
        <button class="button button-secondary" type="button" data-make-slop aria-haspopup="dialog" aria-controls="make-slop-modal">Make my own slop <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg></button>
      </div>
      <p class="hero-meta"><span>Free &amp; open source</span><span>macOS 14+ on Apple silicon</span><span>Signed &amp; notarized</span></p>
      <p class="hero-soon"><span class="soon-pill"><i aria-hidden="true"></i>Windows + iOS coming soon</span></p>
    </div>
    <ul class="hero-stickers" aria-label="Why people like hitSlop">
      <li class="sticker float" data-tone="sun" style="--tilt: -8deg; --delay: -1s">📁 It’s just a file</li>
      <li class="sticker float" data-tone="pink" style="--tilt: 6deg; --delay: -3s">🙅 No account</li>
      <li class="sticker float" data-tone="mint" style="--tilt: -3deg; --delay: -2s">✈️ Works offline</li>
      <li class="sticker float" data-tone="sky" style="--tilt: 7deg; --delay: -4s">🤖 Your AI can edit it</li>
    </ul>
  </div>

  <div class="playground" id="playground">
    <p class="annotation drag-note" aria-hidden="true">Go on, drag us around<svg viewBox="0 0 70 50"><path d="M4 8c27-11 44 13 53 31m-15-7 17 9 2-17" /></svg></p>
    <Desktop client:idle />
    <p class="playground-caption">Interactive previews in your browser. The real ones live on your desktop.</p>
  </div>
</section>

<style>
  .hero { position: relative; width: var(--page); margin: 0 auto; padding: clamp(36px, 5vw, 64px) clamp(8px, 2vw, 24px) 0; }
  .hero-top { display: grid; gap: 32px; align-items: center; padding: 0 clamp(12px, 3vw, 48px); }
  .hero-top > * { min-width: 0; }
  @media (min-width: 1000px) { .hero-top { grid-template-columns: minmax(0, 1fr) auto; } }
  .hero-title { width: max-content; max-width: 100%; font-family: "HitSlop Headline", "HitSlop Display", sans-serif; font-size: clamp(3rem, 8.4vw, 6.6rem); font-weight: 900; line-height: .92; letter-spacing: .005em; }
  .line { position: relative; display: block; width: max-content; max-width: 100%; }
  .line + .line { margin-top: .06em; }
  .smiley { display: inline-block; vertical-align: top; width: .6em; height: .6em; margin: .04em 0 0 .28em; fill: #ffd84a; stroke: var(--ink); stroke-width: 3.4; stroke-linecap: round; rotate: 12deg; }
  .smiley path { fill: none; }
  .smiley .dot { stroke-width: 5; }
  .big { position: relative; z-index: 0; display: inline-block; color: var(--accent); rotate: -3deg; transition: color 400ms var(--ease-out); }
  .big::before { position: absolute; z-index: -1; left: -7%; right: -4%; bottom: 2%; height: .28em; border-radius: 48% 35% 43% 28%; background: #ffe56f; rotate: -5deg; content: ""; }
  .underlined { position: relative; display: inline-block; }
  .underline { position: absolute; z-index: -1; left: 2%; bottom: -.2em; width: 94%; height: .2em; fill: none; stroke: var(--accent-2); stroke-width: 6; stroke-linecap: round; }
  .hero-sub { max-width: 40rem; margin: 26px 0 0; color: var(--muted); font-size: clamp(1.1rem, 1.45vw, 1.35rem); font-weight: 600; line-height: 1.5; }
  .hero-sub strong { color: var(--ink); }
  .hero-actions { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-meta { margin: 16px 0 0; display: flex; flex-wrap: wrap; gap: 4px 14px; color: var(--faint); font-size: .9rem; font-weight: 600; }
  .hero-meta span + span::before { margin-right: 14px; content: "·"; }
  .hero-soon { margin: 12px 0 0; }
  .soon-pill { display: inline-flex; align-items: center; gap: 9px; padding: 7px 14px 7px 12px; border: 2px dashed var(--accent); border-radius: 999px; color: var(--accent); background: var(--accent-soft); font-family: "HitSlop Display", sans-serif; font-size: 1rem; font-weight: 800; line-height: 1; transition: color 400ms var(--ease-out), border-color 400ms var(--ease-out), background-color 400ms var(--ease-out); }
  .soon-pill i { width: 9px; height: 9px; flex: none; border-radius: 50%; background: currentColor; }
  @media (prefers-reduced-motion: no-preference) { .soon-pill i { animation: soon-blink 2s ease-in-out infinite; } }
  @keyframes soon-blink { 50% { opacity: .35; scale: .75; } }
  .hero-stickers { margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 18px 14px; list-style: none; }
  @media (min-width: 1000px) { .hero-stickers { width: 300px; flex-direction: column; align-items: flex-start; gap: 22px; } .hero-stickers li:nth-child(even) { margin-left: 44px; } }
  @media (max-width: 999px) { .hero-stickers .sticker { font-size: .95rem; padding: 8px 12px; } }
  .playground { position: relative; margin-top: clamp(40px, 5vw, 64px); }
  .playground .drag-note { position: absolute; z-index: 5; right: clamp(24px, 12vw, 220px); top: -46px; --tilt: -4deg; }
  .playground .drag-note svg { rotate: 20deg; translate: 0 18px; }
  .playground-caption { margin: 14px 0 0; color: var(--faint); font-size: .9rem; text-align: center; }
  @media (max-width: 779px) {
    .playground .drag-note { display: none; }
    .hero-title { font-size: clamp(2.2rem, 10.6vw, 4.2rem); }
  }
  @media (max-width: 480px) {
    .hero-actions { display: grid; }
    .hero-meta span + span::before { content: none; }
    .hero-meta { gap: 2px 12px; }
  }
</style>
