  fill: #ff7cc0;
  stroke-width: 2.6;
  transform: rotate(-14deg);
}

.hero-big {
  position: relative;
  z-index: 0;
  display: inline-block;
  color: #6c16ed;
  transform: rotate(-3deg);
}

.hero-big::before {
  content: "";
  position: absolute;
  z-index: -1;
  left: -7%;
  right: -4%;
  bottom: 1%;
  height: .28em;
  border-radius: 48% 35% 43% 28%;
  background: #ffe56f;
  transform: rotate(-5deg);
}

.hero-subhead {
