---
import AppleIcon from "./AppleIcon.astro";
import Desktop from "./playground/Desktop.svelte";
import { SITE_LINKS } from "../constants";

const shelf = [
  { emoji: "📝", label: "Notes" },
  { emoji: "✅", label: "Tasks" },
  { emoji: "🍴", label: "Recipes" },
  { emoji: "🎧", label: "Music players" },
  { emoji: "🐾", label: "Desktop pets" },
  { emoji: "🍅", label: "Focus timers" },
  { emoji: "📓", label: "Journals" },
  { emoji: "🌿", label: "Habit streaks" },
  { emoji: "🎨", label: "Pixel art" },
  { emoji: "🧾", label: "Invoices" },
  { emoji: "🌧️", label: "Soundscapes" },
  { emoji: "✈️", label: "Travel plans" },
  { emoji: "🗂️", label: "Flashcards" },
  { emoji: "📊", label: "Spreadsheets" },
  { emoji: "🗓️", label: "Weekly planners" },
  { emoji: "📚", label: "Reading lists" },
  { emoji: "💸", label: "Expense logs" },
  { emoji: "🧳", label: "Packing lists" },
  { emoji: "🎮", label: "Word games" },
  { emoji: "🥑", label: "Grocery lists" },
  { emoji: "📻", label: "Internet radio" },
  { emoji: "💪", label: "Workout logs" },
  { emoji: "📋", label: "Kanban boards" },
  { emoji: "💰", label: "Budgets" },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="kicker"><svg class="doodle rays wide" viewBox="0 0 48 46" aria-hidden="true"><path d="m11 7 14 16M5 32l13 4M40 4l-3 15" /></svg>Local-first mini apps for macOS</p>
      <h1 class="hero-title" id="hero-title">
        <span class="line">Tiny apps.<svg class="smiley wiggle" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="20" /><path d="M16 29c5 6 12 6 17-1" /><path class="dot" d="M17 18v2M31 18v2" /></svg><svg class="doodle title-star wiggle wide" viewBox="0 0 40 40" aria-hidden="true"><path d="m20 3 5 11 12 1-9 8 3 12-11-6-11 6 3-12-9-8 12-1Z" /></svg></span>
        <span class="line"><span class="big">Big</span> <span class="underlined">personality.<svg class="underline draw" viewBox="0 0 300 18" preserveAspectRatio="none" aria-hidden="true" style="--len: 330"><path d="M4 12C70 4 170 3 296 9" /></svg></span></span>
      </h1>
      <p class="hero-sub">A packing list for one trip. A timer shaped like a tomato. A weird little desktop experiment you’ve been meaning to try. Each one is <strong>a single SQLite file you keep</strong>, and your AI can edit it too.</p>
      <div class="hero-actions">
        <a class="button button-primary" href={SITE_LINKS.download}><AppleIcon /> Download for Mac</a>
        <button class="button button-secondary" type="button" data-make-slop aria-haspopup="dialog" aria-controls="make-slop-modal">Make my own slop <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg></button>
      </div>
      <p class="hero-meta"><span>Free &amp; open source</span><span>macOS 15.2+ on Apple silicon</span><span>Signed &amp; notarized</span></p>
      <p class="hero-soon"><span class="soon-pill"><i aria-hidden="true"></i>Coming soon: live collaboration, Windows + iOS</span></p>
      <ul class="hero-stickers" aria-label="Why people like hitSlop">
        <li class="sticker float" data-tone="sun" style="--tilt: -8deg; --delay: -1s">📁 It’s just a SQLite file</li>
        <li class="sticker float" data-tone="pink" style="--tilt: 6deg; --delay: -3s">🙅 No account</li>
        <li class="sticker float" data-tone="sun" style="--tilt: -5deg; --delay: -5s">💸 No subscriptions</li>
        <li class="sticker float" data-tone="mint" style="--tilt: -3deg; --delay: -2s">✈️ Works offline</li>
        <li class="sticker float" data-tone="sky" style="--tilt: 7deg; --delay: -4s">🤖 Your AI can edit it</li>
      </ul>
      <p class="annotation small-files wide" aria-hidden="true">Small files.<br />Big possibilities.<svg viewBox="0 0 70 50"><path d="M4 8c27-11 44 13 53 31m-15-7 17 9 2-17" /></svg></p>
    </div>

    <div class="hero-stage" id="playground">
      <p class="badge wide" aria-hidden="true"><span>Small apps</span><span>big ideas</span><svg viewBox="0 0 24 22"><path d="M12 20S2 14 2 7.5A5 5 0 0 1 12 5a5 5 0 0 1 10 2.5C22 14 12 20 12 20Z" /></svg></p>
      <p class="annotation callout wide" aria-hidden="true">Your desktop.<br />But more you.<svg viewBox="0 0 70 50"><path d="M64 6C40 2 16 14 10 42m-8-12 8 13 12-9" /></svg></p>
      <Desktop client:idle />
      <p class="bubble wide" aria-hidden="true">Local first.<br />Always <span>♥</span><svg viewBox="0 0 30 24"><path d="M4 2c6 10 14 16 24 20C16 22 8 18 2 10" /></svg></p>
      <svg class="doodle stars-top wide" viewBox="0 0 36 75" aria-hidden="true"><path d="M21 3c0 18 4 23 12 25-8 2-12 8-12 23-1-15-5-21-13-23C16 25 20 20 21 3Z" /><path stroke="#f443a1" d="M8 48c0 8 2 11 7 12-5 2-7 4-7 12-1-8-3-10-7-12 4-1 6-4 7-12Z" /></svg>
      <svg class="doodle stars-bottom wide" viewBox="0 0 26 38" aria-hidden="true"><path d="M13 2c0 11 3 15 11 17-8 2-11 6-11 17C12 25 9 21 2 19 9 17 12 13 13 2Z" /></svg>
      <p class="playground-caption">Interactive previews in your browser. The real ones live on your desktop.</p>
    </div>
  </div>

  <div class="shelf" data-shelf aria-label="Things you can make with hitSlop">
    <div class="shelf-window">
      <ul class="shelf-track">
        {shelf.map((item) => <li class="chip"><span aria-hidden="true">{item.emoji}</span>{item.label}</li>)}
        {shelf.map((item) => <li class="chip" aria-hidden="true"><span>{item.emoji}</span>{item.label}</li>)}
      </ul>
    </div>
    <p class="annotation shelf-note wide" aria-hidden="true">More tiny apps<br />this way<svg viewBox="0 0 40 16"><path d="M2 9c12-3 22-3 34-1m-7-6 7 6-7 6" /></svg></p>
    <button class="shelf-pause" type="button" data-shelf-pause aria-pressed="false" aria-label="Pause scrolling categories">
      <svg class="pause-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5v14M15 5v14" /></svg>
      <svg class="play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7Z" /></svg>
    </button>
  </div>
</section>

<script>
  const shelf = document.querySelector<HTMLElement>("[data-shelf]");
  const pause = document.querySelector<HTMLButtonElement>("[data-shelf-pause]");
  pause?.addEventListener("click", () => {
    const paused = shelf!.dataset.paused !== "true";
    shelf!.dataset.paused = String(paused);
    pause.setAttribute("aria-pressed", String(paused));
  });
</script>

<style>
  .hero { position: relative; isolation: isolate; width: min(1680px, calc(100% - 24px)); margin: 0 auto; padding: clamp(28px, 4vw, 56px) clamp(8px, 2vw, 24px) 40px; }
  .hero::before { position: absolute; z-index: -1; inset: -80px calc((100% - 100vw) / 2) 0; pointer-events: none; mask-image: linear-gradient(#000 calc(100% - 140px), transparent); background: radial-gradient(ellipse at 73% 14%, #ddd3ff 0, transparent 55%), radial-gradient(ellipse at 22% 70%, #ffe3f4 0, transparent 50%), radial-gradient(ellipse at 90% 90%, #d6f7f4 0, transparent 46%), radial-gradient(ellipse at 8% 8%, #fff5d6 0, transparent 34%); content: ""; }
  .hero-grid { display: grid; gap: 40px; align-items: center; padding: 0 clamp(12px, 3vw, 48px); }
  .hero-grid > * { min-width: 0; }
  .hero-copy { container-type: inline-size; }
  .hero-title { width: max-content; max-width: 100%; font-family: "HitSlop Headline", "HitSlop Display", sans-serif; font-size: clamp(3rem, 8.4vw, 6.6rem); font-weight: 900; line-height: .92; letter-spacing: .005em; }
  .line { position: relative; display: block; width: max-content; max-width: 100%; }
  .line + .line { margin-top: .06em; }
  .smiley { display: inline-block; vertical-align: top; width: .6em; height: .6em; margin: .04em 0 0 .28em; fill: #ffd84a; stroke: var(--ink); stroke-width: 3.4; stroke-linecap: round; rotate: 12deg; }
  .smiley path { fill: none; }
  .smiley .dot { stroke-width: 5; }
  .big { position: relative; z-index: 0; display: inline-block; color: var(--accent); rotate: -3deg; transition: color 400ms var(--ease-out); }
  .big::before { position: absolute; z-index: -1; left: -7%; right: -4%; bottom: 2%; height: .28em; border-radius: 48% 35% 43% 28%; background: #ffe56f; rotate: -5deg; content: ""; }
  .underlined { position: relative; display: inline-block; }
  .underline { position: absolute; z-index: -1; left: 2%; bottom: -.2em; width: 94%; height: .2em; fill: none; stroke: var(--accent-2); stroke-width: 6; stroke-linecap: round; }
  .hero-sub { max-width: 40rem; margin: 26px 0 0; color: var(--muted); font-size: clamp(1.1rem, 1.45vw, 1.35rem); font-weight: 600; line-height: 1.5; }
  .hero-sub strong { color: var(--ink); }
  .hero-actions { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-meta { margin: 16px 0 0; display: flex; flex-wrap: wrap; gap: 4px 14px; color: var(--faint); font-size: .9rem; font-weight: 600; }
  .hero-meta span + span::before { margin-right: 14px; content: "·"; }
  .hero-soon { margin: 12px 0 0; }
  .soon-pill { display: inline-flex; align-items: center; gap: 9px; padding: 7px 14px 7px 12px; border: 2px dashed var(--accent); border-radius: 999px; color: var(--accent); background: var(--accent-soft); font-family: "HitSlop Display", sans-serif; font-size: 1rem; font-weight: 800; line-height: 1; transition: color 400ms var(--ease-out), border-color 400ms var(--ease-out), background-color 400ms var(--ease-out); }
  .soon-pill i { width: 9px; height: 9px; flex: none; border-radius: 50%; background: currentColor; }
  @media (prefers-reduced-motion: no-preference) { .soon-pill i { animation: soon-blink 2s ease-in-out infinite; } }
  @keyframes soon-blink { 50% { opacity: .35; scale: .75; } }
  .hero-stickers { margin: 26px 0 0; padding: 0 0 0 4px; display: flex; flex-wrap: wrap; gap: 16px 12px; list-style: none; }
  .hero-stickers .sticker { padding: 8px 12px; font-size: .95rem; }

  .hero-stage { position: relative; }
  .hero .wide { display: none; }
  .playground-caption { margin: 14px 0 0; color: var(--faint); font-size: .9rem; text-align: center; }
  @media (min-width: 1200px) { .playground-caption { padding-left: 8px; text-align: left; } }

  .doodle { position: absolute; pointer-events: none; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; }
  .kicker { position: relative; }
  .rays { left: -43px; top: -12px; width: 34px; height: 38px; color: var(--accent); stroke-width: 7; rotate: -8deg; }
  .title-star { right: -.55em; top: -.08em; width: .4em; height: .4em; color: var(--accent-2); stroke-width: 3; }
  .stars-top { right: -30px; top: 8%; width: 36px; height: 75px; color: #ffa92a; stroke-width: 2.5; }
  .stars-bottom { right: -26px; bottom: 26%; width: 26px; height: 38px; color: var(--sky); stroke-width: 2; }
  .badge { position: absolute; z-index: 6; left: -40px; top: -34px; margin: 0; padding: 12px 18px 12px 16px; display: grid; border: 3px solid var(--ink); border-radius: 18px 22px 16px 24px; color: var(--ink); background: #fff; box-shadow: 0 0 0 5px #fff, 0 10px 22px #40247a30; font-family: "HitSlop Display", sans-serif; font-size: clamp(1.05rem, 1.4vw, 1.45rem); font-weight: 800; line-height: .98; letter-spacing: -.02em; text-transform: uppercase; rotate: -12deg; pointer-events: none; user-select: none; }
  .badge span:last-of-type { color: var(--accent); }
  .badge svg { position: absolute; right: -12px; top: -12px; width: 26px; height: 24px; fill: var(--accent-2); stroke: var(--ink); stroke-width: 2; rotate: 14deg; }
  .callout { position: absolute; z-index: 6; right: 4%; top: -40px; color: #3a4fd6; --tilt: -6deg; }
  .callout svg { position: absolute; left: -64px; top: 14px; }
  .bubble { position: absolute; z-index: 6; left: -44px; bottom: 16%; margin: 0; padding: 14px 20px; border: 2.5px solid var(--ink); border-radius: 50% 46% 48% 52% / 56% 50% 50% 44%; color: var(--ink); background: #fff; box-shadow: 0 8px 18px #40247a24; font-family: "HitSlop Handwriting", cursive; font-size: clamp(1.1rem, 1.4vw, 1.4rem); line-height: 1.1; text-align: center; rotate: -8deg; pointer-events: none; user-select: none; }
  .bubble span { color: var(--accent-2); }
  .bubble svg { position: absolute; right: 6px; bottom: -16px; width: 30px; height: 24px; fill: #fff; stroke: var(--ink); stroke-width: 2.5; stroke-linejoin: round; }

  .shelf { position: relative; margin: clamp(28px, 3vw, 44px) clamp(12px, 3vw, 48px) 0; padding: 9px 10px 9px 14px; display: flex; align-items: center; gap: 6px; border: 1px solid #fff; border-radius: 40px; background: #ffffffb8; box-shadow: 0 10px 30px #61478a12; }
  .shelf-window { flex: 1; min-width: 0; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 22px, #000 calc(100% - 22px), transparent); }
  .shelf-track { width: max-content; margin: 0; padding: 4px 0; display: flex; list-style: none; animation: shelf 90s linear infinite; }
  .shelf:hover .shelf-track, .shelf[data-paused="true"] .shelf-track { animation-play-state: paused; }
  @keyframes shelf { to { translate: -50% 0; } }
  .chip { flex: none; min-height: 42px; margin-right: 10px; padding: 0 15px; display: flex; align-items: center; gap: 8px; border: 1px solid #e2def1; border-radius: 24px; background: #ffffffed; box-shadow: 0 3px 5px #31226309; font-size: .9rem; font-weight: 600; white-space: nowrap; }
  .chip span { font-size: 1.15rem; }
  .shelf-pause { width: 40px; height: 40px; flex: none; display: grid; place-items: center; border: 0; border-radius: 50%; color: var(--ink); background: transparent; cursor: pointer; transition: background-color 160ms; }
  .shelf-pause:hover { background: var(--accent-soft); }
  .shelf-pause svg { grid-area: 1 / 1; width: 20px; fill: none; stroke: currentColor; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .shelf-pause .play-icon, .shelf[data-paused="true"] .pause-icon { display: none; }
  .shelf[data-paused="true"] .play-icon { display: block; }
  @media (prefers-reduced-motion: reduce) {
    .shelf-track { animation: none; }
    .shelf-window { overflow-x: auto; scrollbar-width: none; }
    .shelf-track > [aria-hidden="true"], .shelf-pause { display: none; }
  }

  @media (min-width: 1200px) {
    .hero-grid { grid-template-columns: minmax(0, 44fr) minmax(0, 56fr); gap: 22px 40px; padding: 0 clamp(28px, 4vw, 64px); }
    .hero-title { font-size: clamp(3.2rem, 12.4cqw, 6.2rem); }
    .hero-stage { padding-top: 22px; }
    .hero .wide { display: block; }
    .hero .annotation.wide { display: inline-flex; }
    .hero .badge.wide { display: grid; }
    .small-files { margin-top: 18px; }
    .small-files svg { rotate: 8deg; }
    .shelf { margin-inline: clamp(28px, 4vw, 64px); }
    .shelf-note { position: absolute; right: 60px; bottom: calc(100% + 2px); font-size: 1.05rem; text-align: right; --tilt: -4deg; }
  }
  @media (min-width: 1200px) and (max-width: 1359px) {
    .hero-meta { gap: 2px 14px; }
    .hero-meta span + span::before { content: none; }
  }
  @media (min-width: 1200px) and (max-height: 850px) {
    .hero-sub { margin-top: 18px; }
    .hero-actions { margin-top: 20px; }
    .hero-stickers { margin-top: 18px; }
  }
  @media (max-width: 779px) {
    .hero-title { font-size: clamp(2.2rem, 10.6vw, 4.2rem); }
  }
  @media (max-width: 480px) {
    .hero-actions { display: grid; }
    .hero-meta span + span::before { content: none; }
    .hero-meta { gap: 2px 12px; }
  }
</style>
