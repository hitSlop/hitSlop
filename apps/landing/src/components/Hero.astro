---

    <script>
      const play = document.querySelector<HTMLButtonElement>("[data-hero-play]");
      const videoDialog = document.querySelector<HTMLDialogElement>("#hero-video-dialog");
      if (play && videoDialog) {
        const video = videoDialog.querySelector("video")!;
        play.addEventListener("click", () => {
          videoDialog.showModal();
          video.currentTime = 0;
          void video.play().catch(() => {});
        });
        videoDialog.querySelector(".hero-video-close")!.addEventListener("click", () => videoDialog.close());
        videoDialog.addEventListener("click", (event) => { if (event.target === videoDialog) videoDialog.close(); });
        videoDialog.addEventListener("close", () => { video.pause(); play.focus(); });
      }
      const shelf = document.querySelector<HTMLElement>("[data-category-list]");
      const shelfFrame = document.querySelector<HTMLElement>("[data-category-shelf]");
      const pause = document.querySelector<HTMLButtonElement>("[data-shelf-pause]");
      if (shelf && shelfFrame && pause) {
        const motion = matchMedia("(prefers-reduced-motion: reduce)");
        let paused = false;
        let hovered = false;
        let focused = false;
        let loopWidth = 0;
        let lastTime = 0;
        let frame = 0;
        let fractionalStep = 0;
        const measure = () => {
          const first = shelf.firstElementChild;
          const repeat = shelf.querySelector("[data-repeat]");
          if (first && repeat) loopWidth = repeat.getBoundingClientRect().left - first.getBoundingClientRect().left;
        };
        const move = (distance: number) => {
          if (loopWidth) shelf.scrollLeft = (shelf.scrollLeft + distance + loopWidth) % loopWidth;
        };
        const tick = (time: number) => {
          if (lastTime) {
            fractionalStep += Math.min(time - lastTime, 50) * .025;
            const pixels = Math.floor(fractionalStep);
            if (pixels) { move(pixels); fractionalStep -= pixels; }
          }
          lastTime = time;
          frame = requestAnimationFrame(tick);
        };
        const sync = () => {
          cancelAnimationFrame(frame);
          lastTime = 0;
          const stopped = paused || motion.matches;
          pause.dataset.paused = String(stopped);
          pause.setAttribute("aria-label", stopped ? "Play category scrolling" : "Pause category scrolling");
          pause.disabled = motion.matches;
          if (!stopped && !hovered && !focused && !document.hidden) frame = requestAnimationFrame(tick);
        };
        pause.addEventListener("click", () => { paused = !paused; sync(); });
        shelfFrame.addEventListener("pointerenter", () => { hovered = true; sync(); });
        shelfFrame.addEventListener("pointerleave", () => { hovered = false; sync(); });
        shelfFrame.addEventListener("focusin", () => { focused = true; sync(); });
        shelfFrame.addEventListener("focusout", (event) => {
          focused = event.relatedTarget instanceof Node && shelfFrame.contains(event.relatedTarget);
          sync();
        });
        document.querySelectorAll<HTMLButtonElement>("[data-shelf-direction]").forEach((button) => {
          button.addEventListener("click", () => move(Number(button.dataset.shelfDirection) * shelf.clientWidth * .65));
        });
        motion.addEventListener("change", sync);
        document.addEventListener("visibilitychange", sync);
        new ResizeObserver(measure).observe(shelf);
        document.fonts.ready.then(measure);
        measure();
        sync();
        window.addEventListener("pagehide", () => cancelAnimationFrame(frame));
        window.addEventListener("pageshow", sync);
      }
    </script>
<section class="hero-hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-copy">
    <p class="hero-eyebrow">
      <svg class="hero-rays hero-doodle" viewBox="0 0 48 46" aria-hidden="true"><path d="m11 7 14 16M5 32l13 4M40 4l-3 15" /></svg>
      Local-first mini apps for macOS
    </p>
    <h1 class="hero-title" id="hero-title">
      <span class="hero-title-line">Tiny apps.<svg class="hero-smiley hero-doodle" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="20" /><path d="M16 29c5 6 12 6 17-1" /><path class="hero-dot" d="M17 18v2M31 18v2" /></svg><svg class="hero-title-star hero-doodle" viewBox="0 0 40 40" aria-hidden="true"><path d="m20 3 5 11 12 1-9 8 3 12-11-6-11 6 3-12-9-8 12-1Z" /></svg></span>
      <span class="hero-title-line"><span class="hero-big">Big</span> <span class="hero-underlined">personality.<svg class="hero-big-underline" viewBox="0 0 300 18" preserveAspectRatio="none" aria-hidden="true"><path d="M4 12C70 4 170 3 296 9M40 15c60-4 130-5 210-2" /></svg></span></span>
      <svg class="hero-burst hero-doodle" viewBox="0 0 36 54" aria-hidden="true"><path d="m14 11 9-6M17 27l12 1M13 42l9 7" /></svg>
    </h1>
    <p class="hero-subhead">Interactive docs, handy tools, weird little desktop experiments. All in one file.</p>
    <p class="hero-lede">Each <code class="hero-slop">.slop</code> bundles the app and its saved data into one portable file. It stays on your Mac, no account required. Start with Quick Checklist or Small Expenses, then export your work as a PNG or PDF.</p>
    <div class="hero-actions">
      <a class="hero-primary hero-action" href={SITE_LINKS.download}><AppleIcon /> Download for Apple silicon <svg class="hero-action-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" /></svg></a>
      <button class="hero-secondary hero-action" id="make-slop-trigger" type="button" aria-haspopup="dialog" aria-controls="make-slop-modal">Make my own slop <svg class="hero-action-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg></button>
    </div>
    <p class="hero-meta"><span>macOS 14+ · Signed &amp; notarized</span><span class="hero-later">Windows + iOS coming later</span></p>
    <ul class="hero-benefits" aria-label="Key hitSlop features">
      <li class="hero-benefit"><img class="hero-benefit-icon" src="/assets/hero/folder.svg" width="42" height="42" alt="" /><span>Everything<br />in one file</span></li>
      <li class="hero-benefit"><img class="hero-benefit-icon" src="/assets/hero/edit.svg" width="42" height="42" alt="" /><span class="hero-benefit-text">Editable by<br />you or your AI<svg class="hero-little-underline" viewBox="0 0 100 9" preserveAspectRatio="none" aria-hidden="true"><path d="M3 6Q46 0 97 4" /></svg></span></li>
      <li class="hero-benefit"><a class="hero-benefit-link" href="#export-title"><img class="hero-benefit-icon" src="/assets/hero/together.svg" width="42" height="42" alt="" /><span>PNG &amp; PDF<br />export</span></a></li>
    </ul>
    <p class="hero-local-note hero-handwritten" aria-hidden="true">Small files.<br />Big possibilities.
      <svg class="hero-arrow" viewBox="0 0 70 50"><path d="M4 8c27-11 44 13 53 31m-15-7 17 9 2-17" /></svg>
    </p>
  </div>
  <figure class="hero-picture">
    <p class="hero-sticker" aria-hidden="true"><span>Small apps</span><span>big ideas</span><svg class="hero-sticker-heart" viewBox="0 0 24 22"><path d="M12 20S2 14 2 7.5A5 5 0 0 1 12 5a5 5 0 0 1 10 2.5C22 14 12 20 12 20Z" /></svg></p>
    <p class="hero-callout hero-handwritten" aria-hidden="true">Your desktop.<br />But more you.
      <svg class="hero-callout-arrow hero-arrow" viewBox="0 0 70 50"><path d="M64 6C40 2 16 14 10 42m-8-12 8 13 12-9" /></svg>
    </p>
    <div class="hero-media-frame">
      <img class="hero-poster" src={heroPoster} alt="A Mac desktop full of open slops: a Winamp-style music player, a desktop pet, a focus timer, flashcards, a doodle board, a koi pond, Wordle, and school planners" width="1920" height="1080" fetchpriority="high" />
      {heroVideo && (
        <button class="hero-play" type="button" data-hero-play aria-haspopup="dialog" aria-controls="hero-video-dialog">
          <span class="hero-play-disc"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5Z" /></svg></span>
          <span class="hero-play-label">Watch it in action <span class="hero-play-time">0:30</span></span>
        </button>
      )}
    </div>
    <svg class="hero-stars-top hero-doodle" viewBox="0 0 36 75" aria-hidden="true"><path d="M21 3c0 18 4 23 12 25-8 2-12 8-12 23-1-15-5-21-13-23C16 25 20 20 21 3Z" /><path stroke="#f443a1" d="M8 48c0 8 2 11 7 12-5 2-7 4-7 12-1-8-3-10-7-12 4-1 6-4 7-12Z" /></svg>
    <svg class="hero-stars-bottom hero-doodle" viewBox="0 0 26 38" aria-hidden="true"><path d="M13 2c0 11 3 15 11 17-8 2-11 6-11 17C12 25 9 21 2 19 9 17 12 13 13 2Z" /></svg>
    <p class="hero-bubble hero-handwritten" aria-hidden="true">Local first.<br />Always <span class="hero-bubble-heart">♥</span>
      <svg class="hero-bubble-tail" viewBox="0 0 30 24"><path d="M4 2c6 10 14 16 24 20C16 22 8 18 2 10" /></svg>
    </p>
    <svg class="hero-sparkle-left hero-doodle" viewBox="0 0 26 38" aria-hidden="true"><path d="M13 2c0 11 3 15 11 17-8 2-11 6-11 17C12 25 9 21 2 19 9 17 12 13 13 2Z" /></svg>
    <figcaption class="hero-sticky-note hero-handwritten" aria-hidden="true">Ideas<br />live here.
      <svg class="hero-note-smiley" viewBox="0 0 40 40"><path d="M14 13v3M26 13v3M11 23c5 7 13 7 18 0" /></svg>
      <svg class="hero-note-arrow hero-arrow" viewBox="0 0 70 50"><path d="M8 40c30 3 45-11 48-33M46 18 57 5l4 18" /></svg>
    </figcaption>
  </figure>
  {heroVideo && (
    <dialog class="hero-video-dialog" id="hero-video-dialog" aria-label="hitSlop in action">
      <button class="hero-video-close" type="button" aria-label="Close video"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
      <video controls playsinline preload="none" poster={heroPoster} width="1920" height="1080"><source src={heroVideo} type="video/mp4" /></video>
    </dialog>
  )}
  <div class="hero-shelf" data-category-shelf aria-label="Things you can make with hitSlop">
    <button class="hero-shelf-button" type="button" data-shelf-direction="-1" aria-label="Scroll categories left" aria-controls="category-list"><svg class="hero-control-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m14 5-7 7 7 7" /></svg></button>
    <ul class="hero-category-list" id="category-list" data-category-list>
      {categories.map((item) => <li class="hero-category"><span class="hero-emoji" aria-hidden="true">{item.emoji}</span>{item.label}</li>)}
      {categories.map((item) => <li class="hero-category" data-repeat aria-hidden="true"><span class="hero-emoji">{item.emoji}</span>{item.label}</li>)}
    </ul>
    <button class="hero-shelf-button" type="button" data-shelf-direction="1" aria-label="Scroll categories right" aria-controls="category-list"><svg class="hero-control-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m10 5 7 7-7 7" /></svg></button>
    <p class="hero-shelf-note hero-handwritten" aria-hidden="true">More tiny apps<br />this way <svg class="hero-shelf-arrow" viewBox="0 0 40 16"><path d="M2 9c12-3 22-3 34-1m-7-6 7 6-7 6" /></svg></p>
    <button class="hero-shelf-button" type="button" data-shelf-pause data-paused="false" aria-label="Pause category scrolling" aria-controls="category-list"><svg class="hero-pause-icon hero-control-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5v14M15 5v14" /></svg><svg class="hero-play-icon hero-control-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7Z" /></svg></button>
  </div>
</section>

<style>
.hero-hero {
  position: relative;
  isolation: isolate;
  color: #10132c;
  font-family: "HitSlop Sans", sans-serif;
  width: min(1800px, 100%);
  margin: 0 auto;
  padding: 42px clamp(24px, 4vw, 64px) 28px;
  display: grid;
  gap: 32px;
  align-items: center;
}

.hero-hero::before {
  content: "";
  position: absolute;
  z-index: -1;
  inset: 0 calc((100% - 100vw) / 2);
  pointer-events: none;
  background: radial-gradient(ellipse at 73% 14%, #ddd3ff 0, transparent 55%), radial-gradient(ellipse at 22% 70%, #ffe3f4 0, transparent 50%), radial-gradient(ellipse at 90% 90%, #d6f7f4 0, transparent 46%), radial-gradient(ellipse at 8% 8%, #fff5d6 0, transparent 34%);
}

@media screen and (min-width: 1100px) {
  .hero-hero {
    grid-template-columns: minmax(0, 43fr) minmax(0, 57fr);
    gap: 22px 36px;
    padding-top: 32px;
    padding-bottom: 24px;
  }
}

@media screen and (min-width: 1100px) and (max-height: 850px) {
  .hero-hero {
    padding-top: 24px;
    padding-bottom: 16px;
    gap: 16px 28px;
  }
}

@media screen and (max-width: 599px) {
  .hero-hero {
    padding: 36px 24px 24px;
    gap: 28px;
  }
}

.hero-copy {
  position: relative;
  min-width: 0;
  z-index: 2;
}

.hero-eyebrow {
  position: relative;
  margin: 0 0 16px;
  padding-left: 4px;
  color: #6c16ed;
  font-size: clamp(.72rem, .92vw, .88rem);
  font-weight: 900;
  letter-spacing: .16em;
  text-transform: uppercase;
}

.hero-title {
  position: relative;
  width: max-content;
  max-width: 100%;
  margin: 0;
  font-family: "HitSlop Display", "Arial Rounded MT Bold", sans-serif;
  font-size: clamp(3.6rem, 7.2vw, 5.9rem);
  font-weight: 400;
  line-height: .96;
  letter-spacing: -.04em;
  text-wrap: initial;
}

@media screen and (min-width: 1100px) {
  .hero-title {
    font-size: clamp(3.3rem, 4.55vw, 5.3rem);
  }
}

@media screen and (min-width: 1100px) and (max-height: 850px) {
  .hero-title {
    font-size: clamp(3.2rem, 4.3vw, 4.9rem);
  }
}

@media screen and (max-width: 599px) {
  .hero-title {
    font-size: clamp(2.6rem, 10vw, 3.8rem);
  }
}

.hero-title-line {
  position: relative;
