---
import ThemeSwitcher from "../components/ThemeSwitcher.svelte";
import BidirectionalSync from "../components/BidirectionalSync.svelte";
import LiveTogether from "../components/LiveTogether.svelte";
import Hero from "../components/Hero.astro";
import MakeSlopModal from "../components/MakeSlopModal.astro";
import FocusTimer from "../components/FocusTimer.svelte";
import Invoice from "../components/Invoice.svelte";
import TerminalWalkthrough from "../components/TerminalWalkthrough.astro";
import RandomPicker from "../components/RandomPicker.svelte";
import AppleIcon from "../components/AppleIcon.astro";
import GitHubIcon from "../components/GitHubIcon.astro";
import XIcon from "../components/XIcon.astro";
import DiscordIcon from "../components/DiscordIcon.astro";
import { SITE_LINKS } from "../constants";
import "../styles/global.css";

const faqs = [
  { question: "What is a .slop?", answer: "A .slop is a tiny app or a living document, packaged as a single file. Open it, move it, share it, keep it. Its interface and your data travel together." },
  { question: "Where does my data live?", answer: "In the document on your Mac. Your interface and saved state travel together. The two included templates work offline." },
  { question: "Can an AI edit it?", answer: "Yes. A coding agent can create a slop from source, then follow the document’s included instructions to change tasks, notes, numbers, or other saved data. Agents use the document CLI to edit the same live state safely." },
  { question: "Can we edit together?", answer: "Live collaboration is coming soon. Today, your documents stay local and you can share PNG and PDF exports." },
  { question: "Can I change how a slop looks?", answer: "Yes. Change the app’s declared theme tokens with the theme commands; your colors stay with that document. Authors change layout and structure in source and build a new template." },
  { question: "Do I need to host anything?", answer: "No hosting, no database setup, and no server to run. Build a template, register it locally, and create a document on your Mac." },
  { question: "Will my slops update automatically?", answer: "No. Your existing documents keep the app version they were created with. Building a new template makes it available for new copies; it does not change the documents you already use." },
  { question: "Can I share the result without sharing the app?", answer: "Yes. Export the current document as a high-resolution PNG, or a PDF with selectable text and vector output. Good for invoices, recipes, plans, or anything else that needs to leave your desktop." },
];

const platformRequirements = "macOS 14+ · Apple silicon";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fafbfd" />
    <meta name="description" content="Tiny local-first apps and documents that live on your desktop. Create from included templates, edit locally, and export PNG or PDF." />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="preload" href="/assets/hero/fonts/mochiy-pop-one-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/hero/fonts/nunito-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>hitSlop — Tiny apps &amp; docs for your desktop</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="masthead home-masthead">
      <a class="wordmark" href="/" aria-label="hitSlop home"><span class="brand-mark"><img src="/assets/appicon.png" alt="" /></span><span>hitSlop</span></a>
      <nav aria-label="Primary navigation">
        <a href="#why">Why hitSlop</a><a href="#make">Make one</a><a href="#templates">Browse</a>
        <a class="merch-link" href="/merch">Merch</a>
        <a href={SITE_LINKS.docs}>Docs</a>
      </nav>
      <div class="header-actions">
        <div class="social-links">
          <a class="nav-social" href={SITE_LINKS.repository} target="_blank" rel="noopener noreferrer" aria-label="hitSlop on GitHub" title="GitHub"><GitHubIcon /></a>
          <a class="nav-social" href="https://x.com/hitslop" target="_blank" rel="noopener noreferrer" aria-label="hitSlop on X" title="X"><XIcon /></a>
          <a class="nav-social" href={SITE_LINKS.discord} target="_blank" rel="noopener noreferrer" aria-label="Join hitSlop on Discord" title="Discord"><DiscordIcon /></a>
        </div>
        <a class="nav-download" href={SITE_LINKS.download} aria-label="Download" title="Download"><AppleIcon /><span>Download</span></a>
      </div>
    </header>


    <main id="main-content">
      <Hero />
      <MakeSlopModal />

      <section class="objects" id="objects" aria-labelledby="objects-title">
        <div class="section-intro"><p class="eyebrow">One format, many personalities</p><h2 id="objects-title">Little apps, real objects.</h2><p>These interactive demos show what a small desktop tool can do. The Mac release ships with Quick Checklist and Small Expenses; the demos below are previews, not installed templates.</p></div>
        <div class="object-gallery">
          <article class="object object-focus"><div class="object-stage focus-stage"><FocusTimer client:visible /></div><div class="object-caption"><span><strong>Pomodoro</strong>Focus and rest, without a dashboard.</span><small>Instrument · Interactive</small></div></article>
          <article class="object object-invoice"><div class="object-stage invoice-stage"><Invoice client:visible /></div><div class="object-caption"><span><strong>Invoice</strong>Edit the document directly. Totals follow.</span><small>Paper · Interactive</small></div></article>
          <article class="object object-picker"><div class="object-stage picker-stage"><RandomPicker client:visible /></div><div class="object-caption"><span><strong>Random Picker</strong>A tiny decision-making capsule.</span><small>Instrument · Interactive</small></div></article>
        </div>
      </section>




      <section class="make-section" id="make" aria-labelledby="make-title">
        <div class="make-copy"><h2 id="make-title">From your terminal to your desktop.</h2><p>Create a starter, open it in your coding agent, and describe the little app you want. Preview it as you work, then build a <code>.slop</code> you can open on your Mac.</p><p>You’ll need Bun to get started. The project includes instructions for your coding agent, and you keep both the source and the finished app.</p><a class="text-link" href={SITE_LINKS.authoring}>Create your first slop <span aria-hidden="true">→</span></a></div>
        <TerminalWalkthrough />
      </section>


      <section class="local-section" id="why" aria-labelledby="local-title">
        <div class="local-copy">
          <p class="eyebrow">A file, not an account</p><h2 id="local-title">Everything travels with the document.</h2>
          <p>The app and your saved work stay together in one package on your Mac. Close it before moving or copying it. Export a PNG or PDF to share the result.</p>
          <div class="local-actions" aria-label="Things you can do with a slop"><span>Open</span><span>Move</span><span>Duplicate</span><span>Export</span><span>Keep</span></div>
        </div>
        <div class="package-anatomy" aria-label="Contents of a slop document">
          <div class="package-tab"><img src="/assets/appicon.png" alt="" /><span>my-work.slop</span><small>on your Mac</small></div>
          <div class="package-files">
            <div class="app-group">
              <div class="layer-label"><span>app files</span><small>fixed for this release</small></div>
              <div class="file-row immutable"><span>manifest.json</span><small>identity + presentation</small></div>
              <div class="file-row immutable"><span>app.html</span><small>generated interface</small></div>
              <div class="file-row immutable"><span>state.schema.json</span><small>data contract</small></div>
              <div class="file-row immutable"><span>assets/</span><small>compiled JS, CSS + assets</small></div>
              <div class="file-row immutable"><span>.agents/skills/</span><small>AI editing guide</small></div>
              <div class="file-row immutable optional"><span>QuickLook/</span><small>Finder preview + icon</small></div>
            </div>
            <div class="store-group">
              <div class="store-label"><span>state/</span><small>saved document</small></div>
              <div class="file-row"><span>document.sqlite</span><small>durable document data</small></div>
              <div class="file-row optional"><span>theme.json</span><small>your theme overrides</small></div>
            </div>
          </div>
          <p class="package-note"><span>optional</span> where needed · portable in Finder</p>
        </div>
      </section>

      <section class="theme-section" id="themes" aria-labelledby="theme-title">
        <div class="theme-copy"><p class="eyebrow">Make it yours</p><h2 id="theme-title">Same little app, your own colors.</h2><p>Ask your agent to change the theme, or use the theme commands. Your choices stay with the document and carry into its exports.</p><p>Try a palette in this interactive preview. The Mac app supports theme overrides through the CLI; it does not yet have a built-in palette picker.</p><a class="text-link" href="/docs/guides/styling/#let-owners-override-tokens">How theme files work →</a><div class="theme-contract"><code>state/theme.json</code><span>Your overrides travel with the file.</span></div></div>
        <ThemeSwitcher client:visible />
      </section>

      <section class="sync-section" id="agents" aria-labelledby="sync-title">
        <div class="sync-copy"><p class="eyebrow">You and your agent</p><h2 id="sync-title">Two ways to work, one document.</h2><p>Check a task yourself, or ask an agent to do it through the document CLI. Same live state either way. Try applying an operation in this browser-only example.</p></div>
        <BidirectionalSync client:visible />
      </section>

      <section class="collab-section" id="together" aria-labelledby="collab-title">
        <div class="collab-copy"><p class="eyebrow">Coming soon</p><h2 id="collab-title">Little things, better together.</h2><p>Plan a trip, work through a list, or shape an idea together. Live collaboration is coming soon; the people and activity in this interactive preview are simulated.</p><a class="text-link" href="/docs/guides/live-sharing/">More about collaboration →</a></div>
        <LiveTogether client:visible />
      </section>

      <section class="infra-section" aria-labelledby="infra-title">
        <div class="infra-copy"><p class="eyebrow">Keep it simple</p><h2 id="infra-title">No hosting, no database setup.</h2><p>No server to run. Build your app, register the template, and open a local copy. hitSlop takes care of saving the document on your Mac.</p><a class="text-link" href="/docs/guides/build-and-share/">Build your first template →</a></div>
        <div class="infra-list"><p><span>1</span><strong>Build</strong><small>Turn source into a portable template.</small></p><p><span>2</span><strong>Register</strong><small>Add it to your local catalog.</small></p><p><span>3</span><strong>Create</strong><small>Make a writable document and start using it.</small></p></div>
      </section>

      <section class="export-section" aria-labelledby="export-title">
        <div class="export-art" aria-hidden="true"><div class="export-paper"><header><span>Invoice</span><b>PAID</b></header><p>Northwind Studio</p><div><span>Product design</span><strong>$2,500</strong></div><div><span>Development</span><strong>$1,440</strong></div><footer><span>Total</span><strong>$3,940</strong></footer></div><span class="format format-png">PNG<small>2×</small></span><span class="format format-pdf">PDF<small>vector</small></span></div>
        <div class="export-copy"><p class="eyebrow">Share the result</p><h2 id="export-title">The app stays local. The work can go anywhere.</h2><p>Export a crisp PNG or a PDF with selectable text and vector output. Send the invoice, print the recipe, or drop the plan into a message. The recipient doesn't need to install anything.</p><ul><li>Editing controls disappear from captures</li><li>Full document height, not a cropped window</li><li>Preview and Finder icon stay with the file</li></ul></div>
      </section>

      <section class="catalog-section" id="templates" aria-labelledby="catalog-title">
        <div class="catalog-heading"><div><p class="eyebrow">Included templates</p><h2 id="catalog-title">Find your next favorite tiny app.</h2></div><p>Start with a checklist or a small expense tracker. Each creates its own local document.</p></div>
        <p>Quick Checklist and Small Expenses are included in the Mac app. Create a writable copy and start using it offline. Hosted discovery and public publishing are planned for a later release.</p>
      </section>
      <section class="faq-section" aria-labelledby="faq-title"><div><h2 id="faq-title">Got questions?</h2></div><div class="faq-list">{faqs.map((faq) => <details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</div></section>
      <section class="final-cta" aria-labelledby="cta-title"><div><p class="eyebrow">Small files. Big ideas.</p><h2 id="cta-title">Put your next tiny tool on your desktop.</h2></div><a class="button button-primary" href={SITE_LINKS.download}><AppleIcon /> Download for Apple silicon</a><p class="download-meta">Apple silicon · macOS 14+ · Signed &amp; notarized</p><div class="cta-art" aria-hidden="true"><span></span><span></span><img src="/assets/appicon.png" alt="" /></div></section>
    </main>

    <footer class="site-footer" id="community">
      <a class="wordmark" href="/" aria-label="hitSlop home"><span class="brand-mark"><img src="/assets/appicon.png" alt="" /></span><span>hitSlop</span></a><p>Local-first small software for macOS. {platformRequirements}.</p>
      <nav aria-label="Footer navigation"><a href={SITE_LINKS.repository} target="_blank" rel="noreferrer">GitHub</a><a href={SITE_LINKS.docs}>Docs</a>{SITE_LINKS.discord && <a href={SITE_LINKS.discord} target="_blank" rel="noreferrer">Discord</a>}<span>MIT © 2026</span></nav>
    </footer>
  </body>
</html>

<style>
  .masthead { font-family: "HitSlop Sans", sans-serif; color: #10132c; }
  .home-masthead nav, .home-masthead .nav-download { font-weight: 800; }
  .header-actions { display: flex; align-items: center; gap: 16px; }
  .social-links { display: flex; align-items: center; }
  .nav-social { width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; color: #10132c; }
  .nav-social:hover { color: #7922e0; background: #7922e00a; }
  .nav-social :global(svg) { display: block; width: 20px; height: 20px; }
  @media (max-width: 979px) {
    .home-masthead { grid-template-columns: auto 1fr auto; }
    .home-masthead nav { display: flex; justify-content: flex-end; }
    .home-masthead nav a { display: none; }
    .home-masthead nav .merch-link { display: inline-flex; align-items: center; min-height: 44px; font-size: .85rem; font-weight: 700; }
  }
  @media (max-width: 480px) {
    .header-actions { gap: 4px; }
    .home-masthead .nav-download { width: 44px; padding-inline: 0; }
    .nav-download > span { display: none; }
  }
  @media (max-width: 420px) {
    .home-masthead .wordmark > span:last-child { display: none; }
    .home-masthead { padding-inline: 12px; gap: 10px; }
  }
</style>
