---
import SiteHead from "../components/SiteHead.astro";
import Masthead from "../components/Masthead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/Hero.astro";
import VideoDialog from "../components/VideoDialog.astro";
import MakeSlopModal from "../components/MakeSlopModal.astro";
import TemplateWall from "../components/TemplateWall.svelte";
import TypingTerminal from "../components/TypingTerminal.svelte";
import BidirectionalSync from "../components/BidirectionalSync.svelte";
import SlopUnfold from "../components/SlopUnfold.svelte";
import ThemeSwitcher from "../components/ThemeSwitcher.svelte";
import ExportPrinter from "../components/ExportPrinter.svelte";
import LiveTogether from "../components/LiveTogether.svelte";
import AppleIcon from "../components/AppleIcon.astro";
import templates from "../data/templates.json";
import { SITE_LINKS } from "../constants";
import "../styles/global.css";
import "../styles/motion.css";

const count = templates.length;
const burst = templates.map((template) => template.emoji);
const faqs = [
  { question: "What is a .slop?", answer: "A tiny app or a living document, packaged as a single file. Open it, move it, share it, keep it. The interface and your data travel together." },
  { question: "What comes with the app?", answer: `A whole collection: ${count} tiny apps, from checklists, planners and journals to a tomato timer, an invoice, a radio and a koi pond. Pick one from Templates and hitSlop makes you your own copy.` },
  { question: "Where does my data live?", answer: "In the document on your Mac. No account, no server, and every included template works offline." },
  { question: "Can an AI edit it?", answer: "Yes. A coding agent can build a slop from scratch, and it can change the tasks, notes and numbers in a document through the hitSlop CLI. It edits the same live document you have open." },
  { question: "Can I change how a slop looks?", answer: "Yes. Ask your agent or use the theme commands to change a document’s colors; they stay with that document. Authors change layout and structure in source and build a new version." },
  { question: "Will my slops update on their own?", answer: "No. A document keeps the app version it was made with. A new build is available for new copies and never rewrites the ones you already use." },
  { question: "Can I share the result without sharing the app?", answer: "Yes. Export a crisp PNG, or a PDF with selectable text and vector output. Good for invoices, recipes, plans, or anything that needs to leave your desktop." },
  { question: "Can we edit together?", answer: "Live collaboration is coming soon. Today your documents stay on your Mac, and you can send copies or PNG and PDF exports." },
  { question: "Is it free?", answer: "Yes. hitSlop is free and open source under the MIT license." },
];
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead title="hitSlop · Tiny apps. Big personality." description={`Tiny apps and living documents for your Mac. ${count} included templates, each one a single file you keep. Make your own with your AI agent.`} preloadHeadline />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Masthead current="home" />

    <main id="main-content">
      <Hero />

      <section class="section templates" id="templates" aria-labelledby="templates-title">
        <div class="section-head">
          <p class="kicker">{count} tiny apps, included</p>
          <h2 class="headline" id="templates-title">There’s a slop <em>for that.</em></h2>
          <p class="lede">Every one of these comes with hitSlop. Pick one, make a copy, and it’s yours to use, change, or send to a friend.</p>
        </div>
        <p class="annotation surprise-note" aria-hidden="true" style="--tilt: 4deg">can’t decide? let fate pick<svg viewBox="0 0 70 50"><path d="M6 10c20-8 40 2 50 26m-14-6 15 8 2-16" /></svg></p>
        <div class="wall-wrap"><TemplateWall client:visible templates={templates} /></div>
      </section>

      <section class="section panel make" id="make" aria-labelledby="make-title">
        <div class="split">
          <div>
            <p class="kicker">Make your own</p>
            <h2 class="headline" id="make-title">Describe it. <em>Your agent</em> builds it.</h2>
            <p class="lede">Start a project, tell your coding agent what you wish existed, and watch it take shape in your browser. When it feels right, build a <code>.slop</code> and put it on your desktop. You keep the source and the finished app.</p>
            <div class="make-actions">
              <button class="button button-primary" type="button" data-make-slop aria-haspopup="dialog" aria-controls="make-slop-modal">Get the agent prompt</button>
              <a class="text-link" href={SITE_LINKS.authoring}>Read the guide <span aria-hidden="true">→</span></a>
            </div>
            <p class="small-print">Needs <a href="https://bun.sh/" target="_blank" rel="noopener noreferrer">Bun</a> and any coding agent you like. Svelte and your favorite CSS inside.</p>
          </div>
          <div class="make-art"><TypingTerminal client:visible /></div>
        </div>
      </section>

      <section class="section agent" id="agents" aria-labelledby="agent-title">
        <div class="split">
          <div>
            <p class="kicker">You + your agent</p>
            <h2 class="headline" id="agent-title">Two ways to edit. <em>One document.</em></h2>
            <p class="lede">Tick a box yourself, or ask your agent to do it through the document CLI while the window is open. It’s the same live document either way, and the change shows up right away.</p>
          </div>
          <BidirectionalSync client:visible />
        </div>
      </section>

      <section class="section panel file" id="file" aria-labelledby="file-title">
        <div class="section-head">
          <p class="kicker">A file, not an account</p>
          <h2 class="headline" id="file-title">I’m literally <em>just a file.</em></h2>
          <p class="lede">The app and everything you save live together in one package on your Mac. Close it before you move or copy it, the way you would any document.</p>
          <ul class="verbs" aria-label="Things you can do with a slop">
            <li class="sticker" data-tone="sun" style="--tilt: -5deg">Open</li>
            <li class="sticker" data-tone="pink" style="--tilt: 4deg">Move</li>
            <li class="sticker" data-tone="mint" style="--tilt: -2deg">Duplicate</li>
            <li class="sticker" data-tone="sky" style="--tilt: 5deg">Send</li>
            <li class="sticker" style="--tilt: -4deg">Keep forever</li>
          </ul>
        </div>
        <div class="unfold-wrap"><SlopUnfold client:visible /></div>
      </section>

      <section class="section themes" id="themes" aria-labelledby="theme-title">
        <div class="split">
          <div>
            <p class="kicker">Make it yours</p>
            <h2 class="headline" id="theme-title">Same little app. <em>Your colors.</em></h2>
            <p class="lede">Ask your agent to make it purple, or use the theme commands. The colors stay with that document and carry into its exports. Try a palette.</p>
            <p class="annotation theme-note" aria-hidden="true" style="--tilt: -4deg">psst… it repaints this page too<svg viewBox="0 0 70 50"><path d="M4 30c18 10 40 6 52-14m-16-2 17-2-3 17" /></svg></p>
          </div>
          <ThemeSwitcher client:visible />
        </div>
      </section>

      <section class="section panel export" id="export" aria-labelledby="export-title">
        <div class="split flip">
          <div>
            <p class="kicker">Share the result</p>
            <h2 class="headline" id="export-title">The app stays home. <em>The work goes anywhere.</em></h2>
            <p class="lede">Export a crisp PNG or a PDF with selectable text. Send the invoice, print the recipe, drop the plan in a group chat. Nobody needs to install anything.</p>
            <ul class="checks">
              <li>Editing controls disappear from exports</li>
              <li>The whole document, not a cropped window</li>
              <li>A Finder preview and icon that match what’s inside</li>
            </ul>
          </div>
          <ExportPrinter client:visible />
        </div>
      </section>

      <section class="section makers" aria-labelledby="makers-title">
        <div class="split">
          <div>
            <p class="kicker">For makers</p>
            <h2 class="headline" id="makers-title">Share software without starting a startup.</h2>
            <p class="lede">Make a useful little app and hand it to a friend. hitSlop does the saving, the window, the export and the icon.</p>
            <a class="text-link" href="/docs/guides/build-and-share/">Build and share a template <span aria-hidden="true">→</span></a>
          </div>
          <ul class="stamps" aria-label="Things you don’t have to build">
            <li style="--tilt: -6deg"><b>No hosting</b><span>nothing to deploy or keep running</span></li>
            <li style="--tilt: 4deg"><b>No database</b><span>saving is handled for you</span></li>
            <li style="--tilt: -3deg"><b>No accounts</b><span>no logins or password resets</span></li>
            <li style="--tilt: 5deg"><b>No forced updates</b><span>documents keep their version</span></li>
          </ul>
        </div>
      </section>

      <section class="section panel together" aria-labelledby="together-title">
        <div class="split">
          <div>
            <p class="kicker">Coming soon</p>
            <h2 class="headline small" id="together-title">Little things, <em>better together.</em></h2>
            <p class="lede">Plan a trip or split a list with friends, live. Collaboration is on the way; the people in this preview are pretend.</p>
            <a class="text-link" href="/docs/guides/live-sharing/">What’s planned <span aria-hidden="true">→</span></a>
          </div>
          <LiveTogether client:visible />
        </div>
      </section>

      <section class="section faq" aria-labelledby="faq-title">
        <h2 class="headline small" id="faq-title">Got questions?</h2>
        <div class="faq-list">{faqs.map((faq) => <details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</div>
      </section>

      <section class="section final" aria-labelledby="final-title">
        <div class="final-copy">
          <p class="kicker">Small files. Big ideas.</p>
          <h2 class="headline" id="final-title">Put a tiny app on your desktop.</h2>
          <a class="button button-primary final-download" href={SITE_LINKS.download} data-burst={JSON.stringify(burst)}><AppleIcon /> Download for Mac</a>
          <p class="small-print">Free &amp; open source · macOS 14+ on Apple silicon · Signed &amp; notarized · Windows + iOS coming soon</p>
        </div>
        <div class="final-dock" aria-hidden="true">
          <span>🍅</span><span>☑️</span><span class="app"><img src="/assets/appicon-256.webp" width="96" height="96" alt="" loading="lazy" /></span><span>🐟</span><span>📻</span>
        </div>
      </section>
    </main>

    <SiteFooter />
    <VideoDialog />
    <MakeSlopModal />

    <script>
      // A little confetti of real template stickers when someone downloads.
      const download = document.querySelector<HTMLAnchorElement>("[data-burst]");
      if (download && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const pool: string[] = JSON.parse(download.dataset.burst ?? "[]");
        download.addEventListener("click", () => {
          const rect = download.getBoundingClientRect();
          for (let i = 0; i < 18; i++) {
            const bit = document.createElement("span");
            bit.className = "burst-bit";
            bit.textContent = pool[Math.floor(Math.random() * pool.length)] ?? "✨";
            const angle = (Math.PI * 2 * i) / 18 + Math.random() * .4;
            const distance = 120 + Math.random() * 140;
            bit.style.left = `${rect.left + rect.width / 2}px`;
            bit.style.top = `${rect.top + rect.height / 2}px`;
            bit.style.setProperty("--dx", `${Math.cos(angle) * distance}px`);
            bit.style.setProperty("--dy", `${Math.sin(angle) * distance - 60}px`);
            bit.style.setProperty("--spin", `${Math.random() * 720 - 360}deg`);
            document.body.append(bit);
            bit.addEventListener("animationend", () => bit.remove());
          }
        });
      }
    </script>
  </body>
</html>

<style>
  code { font-size: .92em; }
  .headline.small { font-size: clamp(2.2rem, 5vw, 3.6rem); }
  .small-print { margin: 16px 0 0; color: var(--faint); font-size: .92rem; }
  .small-print a { text-decoration: underline; text-underline-offset: 3px; }

  .templates { padding-top: clamp(88px, 11vw, 150px); }
  .templates .surprise-note { position: absolute; right: clamp(24px, 8vw, 120px); top: clamp(120px, 12vw, 190px); }
  .templates .surprise-note svg { rotate: 60deg; translate: 0 22px; }
  .wall-wrap { margin-top: 40px; }

  .make-actions { margin-top: 28px; display: flex; flex-wrap: wrap; align-items: center; gap: 18px; }
  .make-art { min-width: 0; }

  .agent { color: #f3ecf6; background: #251630; border-radius: var(--radius); }
  .agent .headline em { color: #ffd84a; }
  .agent .kicker { color: #ffb38a; }
  .agent .lede { color: #cdbfd6; }

  .verbs { margin: 30px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 14px; list-style: none; }
  .unfold-wrap { margin-top: 46px; }

  .themes { background: #fbe8f7; border-radius: var(--radius); }
  .themes .theme-note { margin-top: 30px; }
  .themes .theme-note svg { rotate: -10deg; }
  @media (max-width: 899px) { .templates .surprise-note { display: none; } }

  .checks { margin: 26px 0 0; padding: 0; display: grid; gap: 10px; list-style: none; font-weight: 700; }
  .checks li { display: flex; align-items: center; gap: 10px; }
  .checks li::before { width: 24px; height: 24px; flex: none; display: grid; place-items: center; border-radius: 50%; color: #fff; background: var(--accent); font-size: .8rem; content: "✓"; }

  .makers { background: #ffd84a; border-radius: var(--radius); }
  .makers .kicker, .makers .text-link { color: #6b3c00; }
  .makers .lede { color: #4a3a12; }
  .stamps { margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; list-style: none; }
  @media (max-width: 480px) { .stamps { grid-template-columns: 1fr; } }
  .stamps li { padding: 20px 18px; display: grid; gap: 4px; border: 3px dashed #b3261e; border-radius: 16px; color: #b3261e; background: #fff8e1; rotate: var(--tilt); box-shadow: 0 8px 18px #6b3c0026; transition: rotate 400ms var(--spring), scale 400ms var(--spring); }
  .stamps b { font-family: "HitSlop Headline", "HitSlop Display", sans-serif; font-size: 1.6rem; font-weight: 900; letter-spacing: .01em; text-transform: uppercase; }
  .stamps span { color: #5b3a1a; font-weight: 700; }
  @media (hover: hover) { .stamps li:hover { rotate: 0deg; scale: 1.05; } }

  .together { background: #e3f1ff; }

  .faq { display: grid; gap: 40px; }
  @media (min-width: 900px) { .faq { grid-template-columns: .6fr 1.4fr; align-items: start; } }
  .faq-list { border-top: 2px solid var(--ink); }
  .faq-list details { border-bottom: 1px solid var(--rule); }
  .faq-list summary { min-height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 24px; cursor: pointer; font-size: 1.15rem; font-weight: 800; list-style: none; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary span { width: 36px; height: 36px; flex: none; display: grid; place-items: center; border: 2px solid var(--ink); border-radius: 50%; color: var(--ink); font-size: 1.3rem; transition: transform 300ms var(--spring), background-color 200ms; }
  .faq-list details[open] summary span { transform: rotate(135deg); background: #ffe66b; }
  .faq-list details p { max-width: 46rem; margin: -6px 0 24px; color: var(--muted); font-size: 1.05rem; line-height: 1.65; }

  .final { display: grid; gap: 40px; align-items: center; overflow: hidden; border-radius: var(--radius); background: radial-gradient(circle at 85% 30%, #ffd1ea, transparent 50%), #ffe0d6; }
  @media (min-width: 900px) { .final { grid-template-columns: 1fr auto; } }
  .final .headline { max-width: 12ch; }
  .final-download { margin-top: 28px; }
  .final-dock { justify-self: center; padding: 14px 16px; display: flex; align-items: flex-end; gap: 12px; border: 1px solid #ffffffcc; border-radius: 28px; background: #ffffffa6; box-shadow: 0 20px 40px #6b1f3a26; backdrop-filter: blur(10px); }
  .final-dock span { width: 64px; height: 64px; display: grid; place-items: center; border-radius: 18px; background: #fff; box-shadow: 0 4px 10px #6b1f3a1f; font-size: 34px; }
  .final-dock .app { width: 96px; height: 96px; padding: 0; overflow: hidden; border-radius: 24px; }
  .final-dock .app img { width: 100%; height: 100%; }
  @media (prefers-reduced-motion: no-preference) { .final-dock .app { animation: dock-bounce 2.8s var(--ease-out) infinite; } }
  @keyframes dock-bounce { 0%, 55%, 100% { translate: 0 0; } 10%, 30% { translate: 0 -34px; } 20%, 40% { translate: 0 0; } }
  @media (max-width: 520px) { .final-dock span { width: 48px; height: 48px; font-size: 26px; } .final-dock .app { width: 72px; height: 72px; } }

  :global(.burst-bit) { position: fixed; z-index: 999; font-size: 30px; pointer-events: none; translate: -50% -50%; animation: burst-fly 1100ms cubic-bezier(.2, .8, .3, 1) forwards; }
  @keyframes burst-fly { to { transform: translate(var(--dx), var(--dy)) rotate(var(--spin)) scale(.7); opacity: 0; } }
</style>
