---
import MerchTryOn from "../components/MerchTryOn.svelte";
import { MERCH_PIECES } from "../merch/pieces";
import { NOTIFY_ENDPOINT } from "../constants";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#c9d1f4" />
    <meta name="description" content="hitSlop merch. Tees, toques, caps and bags for people who make tiny apps. Coming soon." />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="preload" href="/assets/hero/fonts/lilita-one-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/hero/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>hitSlop Merch — Try on the chaos</title>
  </head>
  <body class="merch-page">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="masthead merch-masthead">
      <a class="wordmark" href="/" aria-label="hitSlop home"><span class="brand-mark"><img src="/assets/appicon.png" alt="" /></span><span>hitSlop</span></a>
      <nav aria-label="Primary navigation"><a href="/">The app</a><a href="/merch" aria-current="page">Merch</a><a href="/docs/">Docs</a></nav>
      <div class="merch-actions">
        <span class="soon"><i aria-hidden="true"></i>Coming soon</span>
        <button class="drop" id="join-drop" type="button" aria-haspopup="dialog" aria-controls="merch-signup">Join the drop <span aria-hidden="true">→</span></button>
      </div>
    </header>
    <main id="main-content" tabindex="-1">
      <MerchTryOn client:load pieces={MERCH_PIECES} notifyEndpoint={NOTIFY_ENDPOINT} />
    </main>
  </body>
</html>

<style is:global>
  body.merch-page { height: 100svh; height: 100dvh; overflow: hidden; display: grid; grid-template-rows: 64px minmax(0, 1fr); font-family: "HitSlop Sans", sans-serif; color: #15152e; background: #d6dbf5; }
  .merch-page main { min-height: 0; position: relative; isolation: isolate; background: radial-gradient(ellipse at 8% 2%, #f2edff 0, transparent 54%), radial-gradient(ellipse at 82% 94%, #edf5f3 0, transparent 48%), linear-gradient(125deg, #d5d8f5, #bec9ef 65%, #d9d4ee); }
  .merch-page main::before { content: ""; position: absolute; inset: 0; z-index: -1; opacity: .13; pointer-events: none; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Cpath fill='%23717ca2' filter='url(%23n)' opacity='.35' d='M0 0h160v160H0z'/%3E%3C/svg%3E"); }
  .masthead.merch-masthead { position: relative; grid-template-columns: 1fr auto; background: #f8f9ffed; }
  .merch-masthead nav a[aria-current="page"] { color: #6818de; box-shadow: inset 0 -2px #7921e8; }
  .merch-actions { display: flex; align-items: center; gap: 14px; }
  .merch-actions .soon { display: none; align-items: center; gap: 8px; font-size: .88rem; font-weight: 600; }
  .merch-actions .soon i { width: 9px; height: 9px; border-radius: 50%; background: oklch(70% .17 145); }
  .merch-actions .drop { min-height: 42px; padding: 0 16px; display: inline-flex; align-items: center; gap: 8px; border: 1px solid #e6ca45; border-radius: 9px; color: var(--ink); background: #ffe66b; box-shadow: inset 0 1px #fff7bc; font-size: .88rem; font-weight: 750; cursor: pointer; }
  .merch-actions .drop:hover { background: #ffef93; }
  .merch-page :focus-visible { outline: 3px solid #7138db; outline-offset: 4px; }
  @media (min-width: 600px) { .merch-actions .soon { display: inline-flex; } }
  @media (min-width: 780px) { .masthead.merch-masthead { grid-template-columns: 1fr auto 1fr; } .merch-actions { justify-self: end; } }
  @media (max-width: 380px) { .merch-masthead { padding-inline: 14px; } .merch-actions .drop { padding-inline: 12px; font-size: .82rem; } }
</style>
