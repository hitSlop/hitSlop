rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A personal catalog is a list of references. The document service authorizes
    // actual document access; catalog fields never grant permissions.
    match /users/{userId}/documents/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Preserve existing project collection policies during the catalog rollout.
    match /syncRooms/{roomId}/updates/{updateId} {
      allow read: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/syncRooms/$(roomId)).data.members;
      allow write: if false;
    }
    match /templates/{templateId} {
      allow read: if resource.data.visibility == "public";
      allow write: if false;
    }

    match /publishers/{publisherId} {
      allow read: if true;
      allow write: if false;
    }

    match /releases/{releaseId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
