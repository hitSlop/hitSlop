{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "bun"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/document/**/*.ts",
    "packages/cli/src/**/*.ts",
    "packages/schema/src/**/*.ts",
    "scripts/**/*.ts",
    "tests/native/**/*.ts",
    "tests/packed/**/*.ts",
    "packages/shell/**/*.ts"
  ],
  "exclude": [
    "**/dist/**"
  ]
}
