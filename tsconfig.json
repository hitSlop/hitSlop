{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "bun"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/hitslop/src/**/*.ts",
    "packages/hitslop/tests/sdk/**/*.ts",
    "packages/hitslop/tests/shell/**/*.ts",
    "scripts/**/*.ts",
    "tests/native/**/*.ts",
    "tests/packed/**/*.ts",
    "tests/verification/**/*.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "packages/hitslop/.crust/**"
  ]
}
