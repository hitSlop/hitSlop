{
  "name": "hitslop",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/document",
    "packages/shell",
    "packages/schema",
    "packages/cli",
    "examples/slops"
  ],
  "scripts": {
    "slop": "bun packages/cli/src/cli.ts",
    "schema:generate": "bun scripts/generate.ts",
    "schema:check": "bun scripts/generate.ts --check",
    "build": "bun scripts/build.ts",
    "check": "bun scripts/check.ts",
    "test": "bun scripts/test.ts",
    "swift:test": "bun scripts/swift-test.ts",
    "bench:windows": "HITSLOP_BENCH=1 bun run swift:test --filter BenchmarkTests",
    "bench:growth": "bun scripts/bench-document-growth.ts",
    "test:native-crash": "bun scripts/native-crash.ts",
    "test:native-helper": "bun scripts/native-helper.ts",
    "apple:build": "bun scripts/apple-build.ts",
    "skills:build": "bun scripts/skills.ts",
    "packages:pack": "bun scripts/packages.ts",
    "test:packed": "bun scripts/packed-test.ts",
    "hygiene": "bun scripts/hygiene.ts",
    "presentation:fixtures": "bun scripts/presentation-fixtures.ts",
    "landing:check": "bun run --cwd apps/landing check",
    "landing:build": "bun run --cwd apps/landing build",
    "test:native": "bun scripts/test.ts --native",
    "check:built": "bun scripts/check-built.ts",
    "release:check": "bun scripts/release-check.ts",
    "build:templates": "bun scripts/build-templates.ts",
    "test:render": "bun scripts/native-smoke.ts",
    "test:restored": "bun scripts/restored-smoke.ts",
    "test:compat": "bun scripts/compat-replay.ts",
    "compat:capture": "bun scripts/compat-capture.ts",
    "core:build": "bun scripts/core-build.ts",
    "core:build:wasm": "bun scripts/core-build.ts --wasm",
    "core:build:native": "bun scripts/core-build.ts --native",
    "core:build:engine": "bun scripts/core-build.ts --engine",
    "core:test": "cargo test --locked --workspace",
    "core:test:extended": "HITSLOP_MODEL_SEEDS=64 HITSLOP_MODEL_STEPS=500 cargo test --locked --release -p hitslop-core --test model",
    "shape:lab": "bun scripts/shape-lab.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright": "1.63.0",
    "quicktype-core": "26.0.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typebox": "1.3.32",
    "typescript": "5.9.2",
    "vite": "8.3.1"
  }
}
