{
  "name": "hitslop",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/document",
    "packages/schema",
    "packages/cli",
    "examples/slops"
  ],
  "scripts": {
    "slop": "bun packages/cli/src/cli.ts",
    "schema:generate": "bun scripts/v1/generate.ts",
    "schema:check": "bun scripts/v1/generate.ts --check",
    "build": "bun scripts/v1/build.ts",
    "check": "bun scripts/v1/check.ts",
    "test": "bun scripts/v1/test.ts",
    "slops:dev": "bun packages/cli/src/cli.ts dev examples/slops/quick-checklist",
    "swift:build": "swift build --package-path apps/apple/Packages/HitSlopApple --product hitslop-native",
    "test:local": "bun run release:check",
    "test:built": "bun scripts/v1/release-check.ts --built",
    "swift:test": "bun scripts/v1/swift-test.ts",
    "bench:windows": "HITSLOP_BENCH=1 bun run swift:test --filter BenchmarkTests",
    "test:native-crash": "bun scripts/v1/native-crash.ts",
    "test:native-helper": "bun scripts/v1/native-helper.ts",
    "apple:build": "bun scripts/v1/apple-build.ts",
    "skills:build": "bun scripts/v1/skills.ts",
    "packages:pack": "bun scripts/v1/packages.ts",
    "test:packed": "bun scripts/v1/packed-test.ts",
    "hygiene": "bun scripts/v1/hygiene.ts",
    "presentation:fixtures": "bun scripts/v1/presentation-fixtures.ts",
    "landing:check": "bun run --cwd apps/landing check",
    "landing:build": "bun run --cwd apps/landing build",
    "test:native": "bun scripts/v1/test.ts --native",
    "check:built": "bun scripts/v1/check-built.ts",
    "release:check": "bun scripts/v1/release-check.ts",
    "build:templates": "bun scripts/v1/build-templates.ts",
    "test:render": "bun scripts/v1/native-smoke.ts",
    "core:build": "bun scripts/v1/core-build.ts",
    "core:build:wasm": "bun scripts/v1/core-build.ts --wasm",
    "core:build:native": "bun scripts/v1/core-build.ts --native",
    "core:test": "cargo test --locked --workspace"
  },
  "devDependencies": {
    "@hitslop/document": "workspace:*",
    "@hitslop/schema": "workspace:*",
    "@lucide/svelte": "^1.47.0",
    "@types/bun": "latest",
    "bits-ui": "^2.19.2",
    "esbuild": "^0.28.2",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "quicktype-core": "26.0.0",
    "svelte": "5.57.1",
    "svelte-check": "^4.7.6",
    "typebox": "^1.3.32",
    "typescript": "5.9.2"
  }
}
