{
  "name": "pop-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/pop",
    "pop"
  ],
  "scripts": {
    "pop": "bun packages/pop/src/cli/cli.ts",
    "schema:generate": "bun scripts/build/generate.ts",
    "build": "bun scripts/build/build.ts",
    "verify": "bun scripts/verify.ts",
    "check": "bun scripts/verify.ts contracts,types",
    "lint": "oxlint packages/pop/src scripts",
    "test": "bun scripts/verify.ts tooling,bun,cli",
    "swift:test": "bun scripts/verify.ts swift",
    "swift:format": "bun scripts/lib/swift-format.ts",
    "bench:windows": "POP_BENCH=1 bun run swift:test --filter BenchmarkTests",
    "bench:growth": "bun scripts/dev/bench-document-growth.ts",
    "apple:build": "bun scripts/build/apple.ts",
    "skills:build": "bun scripts/build/skills.ts",
    "packages:pack": "bun scripts/build/packages.ts",
    "landing:check": "bun run --cwd apps/landing check",
    "landing:build": "bun run --cwd apps/landing build",
    "test:native": "bun scripts/verify.ts native",
    "release:check": "bun scripts/verify.ts --release",
    "release:notes": "bun scripts/release/notes.ts",
    "build:templates": "bun scripts/templates/build.ts",
    "compat:resolve": "bun scripts/compat/corpora.ts",
    "compat:runner": "bun scripts/build/runner.ts",
    "compat:capture": "bun scripts/compat/capture.ts",
    "core:build:wasm": "bun scripts/build/core.ts --wasm",
    "core:test": "bun scripts/verify.ts rust",
    "core:test:extended": "POP_MODEL_SEEDS=64 POP_MODEL_STEPS=500 POP_MERGE_SEEDS=400 POP_COMPAT_SEEDS=16 POP_COMPAT_STEPS=40 NEXTEST_PROFILE=extended bun scripts/verify.ts rust --release -p pop-core -p pop-runtime -E 'test(/^model::/) | test(/^merge::/) | test(/^compat_writers::/)'"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251106.1",
    "@lucide/svelte": "1.52.0",
    "@types/bun": "1.4.2",
    "@types/pngjs": "6.0.5",
    "bits-ui": "^2.19.5",
    "@hitslop/pop": "workspace:*",
    "miniflare": "4.20251105.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "1.64.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.3"
  },
  "version": "3.0.0"
}
